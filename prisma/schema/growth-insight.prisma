// G9 (D-289 (6), D-301): verified building reviews and the energy-insight opt-in for getenergy; migration 0066,
// schema-design §7.5 rows 195–200.

enum BuildingReviewState {
  pending_moderation
  published
  rejected
  hidden
  withdrawn

  @@map("building_review_state")
  @@schema("ops")
}

enum EnergyInsightState {
  opted_in
  opted_out

  @@map("energy_insight_state")
  @@schema("platform")
}

/// One review per lease by a party who lived under it (G9, D-301); moderated; never deleted; reviewer not shown.
model BuildingReview {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  buildingId       String              @map("building_id") @db.Uuid
  unitId           String              @map("unit_id") @db.Uuid
  leaseId          String              @unique(map: "building_review_lease_id_key") @map("lease_id") @db.Uuid
  authorPartyId    String              @map("author_party_id") @db.Uuid
  authorUserId     String?             @map("author_user_id") @db.Uuid
  consentId        String?             @map("consent_id") @db.Uuid
  rating           Int                 @db.SmallInt
  body             String?
  language         String              @default("th") @db.Char(2)
  tenureFrom       DateTime            @map("tenure_from") @db.Date
  tenureTo         DateTime?           @map("tenure_to") @db.Date
  state            BuildingReviewState
  submittedAt      DateTime            @map("submitted_at") @db.Timestamptz(6)
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz(6)
  moderatedAt      DateTime?           @map("moderated_at") @db.Timestamptz(6)
  moderatedBy      String?             @map("moderated_by") @db.Uuid
  moderationReason String?             @map("moderation_reason")
  ownerReply       String?             @map("owner_reply")
  ownerRepliedAt   DateTime?           @map("owner_replied_at") @db.Timestamptz(6)
  ownerRepliedBy   String?             @map("owner_replied_by") @db.Uuid
  reportedAt       DateTime?           @map("reported_at") @db.Timestamptz(6)
  reportReason     String?             @map("report_reason")
  withdrawnAt      DateTime?           @map("withdrawn_at") @db.Timestamptz(6)
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedAt        DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?             @map("updated_by") @db.Uuid

  tenant      Tenant       @relation("BuildingReviewTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_review_tenant_id_fkey")
  building    Building     @relation("BuildingReviewBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_review_building_id_fkey")
  unit        Unit         @relation("BuildingReviewUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_review_unit_id_fkey")
  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_review_lease_id_fkey")
  authorParty Party        @relation("BuildingReviewAuthorParty", fields: [authorPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_review_author_party_id_fkey")
  authorUser  UserAccount? @relation("BuildingReviewAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "building_review_author_user_id_fkey")
  consent     Consent?     @relation(fields: [consentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "building_review_consent_id_fkey")
  moderator   UserAccount? @relation("BuildingReviewModeratedBy", fields: [moderatedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "building_review_moderated_by_fkey")
  replier     UserAccount? @relation("BuildingReviewOwnerRepliedBy", fields: [ownerRepliedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "building_review_owner_replied_by_fkey")

  @@index([buildingId, state, publishedAt(sort: Desc)], map: "building_review_building_id_state_idx")
  @@index([tenantId, state, submittedAt(sort: Desc)], map: "building_review_tenant_id_state_idx")
  @@index([state, submittedAt], map: "building_review_state_submitted_at_idx", where: raw("((state = 'pending_moderation'::ops.building_review_state) OR (reported_at IS NOT NULL))"))
  @@index([unitId], map: "building_review_unit_id_idx")
  @@index([authorPartyId], map: "building_review_author_party_id_idx")
  @@index([authorUserId], map: "building_review_author_user_id_idx")
  @@index([consentId], map: "building_review_consent_id_idx")
  @@index([moderatedBy], map: "building_review_moderated_by_idx")
  @@index([ownerRepliedBy], map: "building_review_owner_replied_by_idx")
  @@map("building_review")
  @@schema("ops")
}

/// The building owner's opt-in to share aggregate energy figures with getenergy (G9, D-289 (6), D-301, O-028).
model EnergyInsightOptin {
  id                      String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                String             @map("tenant_id") @db.Uuid
  buildingId              String             @unique(map: "energy_insight_optin_building_id_key") @map("building_id") @db.Uuid
  state                   EnergyInsightState
  consentId               String?            @map("consent_id") @db.Uuid
  consentPurposeVersionId String?            @map("consent_purpose_version_id") @db.Uuid
  optedInAt               DateTime           @map("opted_in_at") @db.Timestamptz(6)
  optedInBy               String?            @map("opted_in_by") @db.Uuid
  optedOutAt              DateTime?          @map("opted_out_at") @db.Timestamptz(6)
  optedOutBy              String?            @map("opted_out_by") @db.Uuid
  lastSharedAt            DateTime?          @map("last_shared_at") @db.Timestamptz(6)
  lastScore               Int?               @map("last_score") @db.SmallInt
  lastIntegrationEventId  String?            @map("last_integration_event_id") @db.Uuid
  version                 Int                @default(1)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy               String?            @map("created_by") @db.Uuid
  updatedAt               DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy               String?            @map("updated_by") @db.Uuid

  tenant                 Tenant                 @relation("EnergyInsightOptinTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "energy_insight_optin_tenant_id_fkey")
  building               Building               @relation("EnergyInsightOptinBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "energy_insight_optin_building_id_fkey")
  consent                Consent?               @relation(fields: [consentId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "energy_insight_optin_consent_id_fkey")
  consentPurposeVersion  ConsentPurposeVersion? @relation(fields: [consentPurposeVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "energy_insight_optin_consent_purpose_version_id_fkey")
  optedInUser            UserAccount?           @relation("EnergyInsightOptinOptedInBy", fields: [optedInBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "energy_insight_optin_opted_in_by_fkey")
  optedOutUser           UserAccount?           @relation("EnergyInsightOptinOptedOutBy", fields: [optedOutBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "energy_insight_optin_opted_out_by_fkey")
  lastIntegrationEvent   IntegrationEvent?      @relation(fields: [lastIntegrationEventId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "energy_insight_optin_last_integration_event_id_fkey")

  @@index([tenantId], map: "energy_insight_optin_tenant_id_idx")
  @@index([state, lastSharedAt], map: "energy_insight_optin_state_last_shared_at_idx", where: raw("(state = 'opted_in'::platform.energy_insight_state)"))
  @@index([consentId], map: "energy_insight_optin_consent_id_idx")
  @@index([consentPurposeVersionId], map: "energy_insight_optin_consent_purpose_version_id_idx")
  @@index([optedInBy], map: "energy_insight_optin_opted_in_by_idx")
  @@index([optedOutBy], map: "energy_insight_optin_opted_out_by_idx")
  @@index([lastIntegrationEventId], map: "energy_insight_optin_last_integration_event_id_idx")
  @@map("energy_insight_optin")
  @@schema("platform")
}

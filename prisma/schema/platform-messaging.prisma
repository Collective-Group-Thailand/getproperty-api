enum MessagingChannelState {
  pending
  verified
  failing
  revoked

  @@map("messaging_channel_state")
  @@schema("platform")
}

/// An operator's own LINE Messaging API channel (D-254); no row = the shared getproperty OA.
model MessagingChannel {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  buildingId    String?               @map("building_id") @db.Uuid
  lineChannelId String                @map("line_channel_id")
  secretEnc     Bytes                 @map("secret_enc")
  tokenEnc      Bytes                 @map("token_enc")
  webhookKey    String                @unique(map: "messaging_channel_webhook_key_key") @map("webhook_key")
  botUserId     String?               @map("bot_user_id")
  botName       String?               @map("bot_name")
  botPictureUrl String?               @map("bot_picture_url")
  state         MessagingChannelState @default(pending)
  verifiedAt    DateTime?             @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime?             @map("last_checked_at") @db.Timestamptz(6)
  lastError     String?               @map("last_error")
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?               @map("created_by") @db.Uuid
  updatedAt     DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?               @map("updated_by") @db.Uuid

  tenant     Tenant                  @relation("MessagingChannelTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_channel_tenant_id_fkey")
  building   Building?               @relation("MessagingChannelBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_channel_building_id_fkey")
  users      MessagingChannelUser[]
  linkTokens MessagingLinkToken[]
  usage      MessageUsage[]

  @@unique([tenantId], map: "messaging_channel_tenant_scope_key", where: raw("((building_id IS NULL) AND (state <> 'revoked'::platform.messaging_channel_state))"))
  @@unique([tenantId, buildingId], map: "messaging_channel_building_scope_key", where: raw("((building_id IS NOT NULL) AND (state <> 'revoked'::platform.messaging_channel_state))"))
  @@index([buildingId], map: "messaging_channel_building_id_idx")
  @@map("messaging_channel")
  @@schema("platform")
}

/// A login linked to an own OA: the OA's user id for that login (D-254).
model MessagingChannelUser {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  channelId  String    @map("channel_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  lineUserId String    @map("line_user_id")
  linkedAt   DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt DateTime? @map("unlinked_at") @db.Timestamptz(6)

  tenant  Tenant           @relation("MessagingChannelUserTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_channel_user_tenant_id_fkey")
  channel MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_channel_user_channel_id_fkey")
  user    UserAccount      @relation("MessagingChannelUserUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_channel_user_user_id_fkey")

  @@unique([channelId, userId], map: "messaging_channel_user_channel_user_key", where: raw("(unlinked_at IS NULL)"))
  @@unique([channelId, lineUserId], map: "messaging_channel_user_channel_line_key", where: raw("(unlinked_at IS NULL)"))
  @@index([userId], map: "messaging_channel_user_user_id_idx")
  @@index([tenantId], map: "messaging_channel_user_tenant_id_idx")
  @@map("messaging_channel_user")
  @@schema("platform")
}

/// Single-use account-linking tokens of an own OA (D-254).
model MessagingLinkToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  channelId  String    @map("channel_id") @db.Uuid
  tokenHash  Bytes     @unique(map: "messaging_link_token_token_hash_key") @map("token_hash")
  lineUserId String    @map("line_user_id")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  usedBy     String?   @map("used_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant           @relation("MessagingLinkTokenTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_link_token_tenant_id_fkey")
  channel MessagingChannel @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_link_token_channel_id_fkey")
  user    UserAccount?     @relation("MessagingLinkTokenUser", fields: [usedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_link_token_used_by_fkey")

  @@index([channelId, lineUserId], map: "messaging_link_token_channel_id_idx")
  @@index([tenantId], map: "messaging_link_token_tenant_id_idx")
  @@index([usedBy], map: "messaging_link_token_used_by_idx")
  @@map("messaging_link_token")
  @@schema("platform")
}

enum MessagingRateState {
  entered
  published
  withdrawn

  @@map("messaging_rate_state")
  @@schema("platform")
}

enum MessagingOa {
  shared
  own

  @@map("messaging_oa")
  @@schema("platform")
}

enum MessageKind {
  push
  reply

  @@map("message_kind")
  @@schema("platform")
}

enum MessagingNoticeKind {
  allowance_80
  allowance_100
  quota

  @@map("messaging_notice_kind")
  @@schema("platform")
}

/// The shared getproperty OA's charge per version (D-254); maker-checker publish. None published = not charged.
model MessagingRate {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  effectiveFrom   DateTime           @map("effective_from") @db.Date
  freePerTenant   Int                @map("free_per_tenant")
  freePerUnit     Int                @default(0) @map("free_per_unit")
  pricePerMessage Decimal            @map("price_per_message") @db.Decimal(10, 4)
  vatPercent      Decimal            @map("vat_percent") @db.Decimal(5, 2)
  notes           String?
  state           MessagingRateState @default(entered)
  enteredBy       String             @map("entered_by") @db.Uuid
  enteredAt       DateTime           @default(now()) @map("entered_at") @db.Timestamptz(6)
  publishedBy     String?            @map("published_by") @db.Uuid
  publishedAt     DateTime?          @map("published_at") @db.Timestamptz(6)
  withdrawnAt     DateTime?          @map("withdrawn_at") @db.Timestamptz(6)

  enterer   UserAccount  @relation("MessagingRateEnterer", fields: [enteredBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_rate_entered_by_fkey")
  publisher UserAccount? @relation("MessagingRatePublisher", fields: [publishedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_rate_published_by_fkey")

  @@unique([effectiveFrom], map: "messaging_rate_published_key", where: raw("(state = 'published'::platform.messaging_rate_state)"))
  @@map("messaging_rate")
  @@schema("platform")
}

/// Every LINE message sent for a tenant (D-254): shared or own OA, push or reply, what LINE counts. Append-only.
model MessageUsage {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  buildingId     String?     @map("building_id") @db.Uuid
  channelId      String?     @map("channel_id") @db.Uuid
  notificationId String?     @unique(map: "message_usage_notification_id_key") @map("notification_id") @db.Uuid
  oa             MessagingOa
  kind           MessageKind
  counted        Int
  month          DateTime    @db.Date
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant  Tenant            @relation("MessageUsageTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "message_usage_tenant_id_fkey")
  channel MessagingChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "message_usage_channel_id_fkey")

  @@index([tenantId, month], map: "message_usage_tenant_id_month_idx")
  @@index([channelId], map: "message_usage_channel_id_idx")
  @@map("message_usage")
  @@schema("platform")
}

/// Messaging notices sent to a tenant (D-254): 80 % / 100 % of the free messages, a quota refusal — once per month.
model MessagingNotice {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  month     DateTime            @db.Date
  kind      MessagingNoticeKind
  counted   Int
  allowance Int?
  sentAt    DateTime            @default(now()) @map("sent_at") @db.Timestamptz(6)

  tenant Tenant @relation("MessagingNoticeTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "messaging_notice_tenant_id_fkey")

  @@unique([tenantId, month, kind], map: "messaging_notice_tenant_id_month_kind_key")
  @@map("messaging_notice")
  @@schema("platform")
}

// G4 (D-288, D-296): a tenant's own Facebook Page; migration 0062, schema-design §7.5 row 170.

enum SocialProvider {
  facebook_page

  @@map("social_provider")
  @@schema("platform")
}

enum SocialChannelState {
  verified
  failing
  revoked

  @@map("social_channel_state")
  @@schema("platform")
}

/// A tenant's own Facebook Page (D-288); the Page access token sealed with the tenant data key (D-148 / D-240).
model SocialChannel {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  provider      SocialProvider     @default(facebook_page)
  pageId        String             @map("page_id")
  pageName      String?            @map("page_name")
  tokenEnc      Bytes              @map("token_enc")
  state         SocialChannelState @default(verified)
  autoPost      Boolean            @default(true) @map("auto_post")
  verifiedAt    DateTime?          @map("verified_at") @db.Timestamptz(6)
  lastCheckedAt DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  lastError     String?            @map("last_error")
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedBy     String?            @map("revoked_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?            @map("created_by") @db.Uuid
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?            @map("updated_by") @db.Uuid

  tenant Tenant              @relation("SocialChannelTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "social_channel_tenant_id_fkey")
  posts  ListingSocialPost[]

  @@unique([tenantId, provider], map: "social_channel_tenant_provider_key", where: raw("(state <> 'revoked'::platform.social_channel_state)"))
  @@index([tenantId, state], map: "social_channel_tenant_id_state_idx")
  @@map("social_channel")
  @@schema("platform")
}

  // back-relations of app models (injected by asset-core prisma-fragment)
  accessCredentialHolderParty  AccessCredential[] @relation("AccessCredentialHolderParty")
  announcementReadParty        AnnouncementRead[] @relation("AnnouncementReadParty")
  buildingRuleAckParty         BuildingRuleAck[] @relation("BuildingRuleAckParty")
  contactParty                 Contact[] @relation("ContactParty")
  csatResponseParty            CsatResponse[] @relation("CsatResponseParty")
  facilityBookingParty         FacilityBooking[] @relation("FacilityBookingParty")
  invitationParty              Invitation[] @relation("InvitationParty")
  invoiceBilledParty           Invoice[] @relation("InvoiceBilledParty")
  invoiceChargeParty           InvoiceCharge[] @relation("InvoiceChargeParty")
  leaseLessee                  Lease[] @relation("LeaseLessee")
  leasePartyParty              LeaseParty[] @relation("LeasePartyParty")
  leaseSignatureParty          LeaseSignature[] @relation("LeaseSignatureParty")
  maintenancePlanAssigneeParty MaintenancePlan[] @relation("MaintenancePlanAssigneeParty")
  notificationPreferenceParty  NotificationPreference[] @relation("NotificationPreferenceParty")
  occupantProfileParty         OccupantProfile? @relation("OccupantProfileParty")
  parcelPickedUpBy             Parcel[] @relation("ParcelPickedUpBy")
  parcelRecipient              Parcel[] @relation("ParcelRecipient")
  partyLinkRequestParty        PartyLinkRequest[] @relation("PartyLinkRequestParty")
  payerCreditParty             PayerCredit[] @relation("PayerCreditParty")
  paymentPayer                 Payment[] @relation("PaymentPayer")
  penaltyAssessmentParty       PenaltyAssessment[] @relation("PenaltyAssessmentParty")
  receiptPayer                 Receipt[] @relation("ReceiptPayer")
  receivableBalanceParty       ReceivableBalance[] @relation("ReceivableBalanceParty")
  receivableEntryParty         ReceivableEntry[] @relation("ReceivableEntryParty")
  refundParty                  Refund[] @relation("RefundParty")
  serviceMessageAuthorParty    ServiceMessage[] @relation("ServiceMessageAuthorParty")
  serviceRequestRequester      ServiceRequest[] @relation("ServiceRequestRequester")
  slipReviewPayer              SlipReview[] @relation("SlipReviewPayer")
  taxInvoiceBuyer              TaxInvoice[] @relation("TaxInvoiceBuyer")
  tm30ExportParty              Tm30Export[] @relation("Tm30ExportParty")
  workOrderAssigneeParty       WorkOrder[] @relation("WorkOrderAssigneeParty")
  workOrderCostLineVendor      WorkOrderCostLine[] @relation("WorkOrderCostLineVendor")

  @@index([tenantId, phoneHash], map: "party_tenant_id_phone_hash_idx")
  @@index([tenantId, idNumberHash], map: "party_tenant_id_id_number_hash_idx")
  @@index([tenantId, lineUserId], map: "party_tenant_id_line_user_id_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "party_display_name_trgm_idx")
  @@index([phoneE164], map: "party_phone_e164_idx", where: raw("((deleted_at IS NULL) AND (anonymised_at IS NULL))"))
  @@index([lineUserId], map: "party_line_user_id_idx", where: raw("((deleted_at IS NULL) AND (anonymised_at IS NULL))"))
  @@map("party")
  @@schema("core")
}

/// Party ↔ login (one LINE account across many parties/tenants, D-061).
model PartyUserLink {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  partyId      String         @map("party_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  identityId   String?        @map("identity_id") @db.Uuid
  state        PartyLinkState @default(active)
  linkedAt     DateTime       @default(now()) @map("linked_at") @db.Timestamptz(6)
  linkedVia    PartyLinkVia   @map("linked_via")
  unlinkedAt   DateTime?      @map("unlinked_at") @db.Timestamptz(6)
  unlinkedBy   String?        @map("unlinked_by") @db.Uuid
  unlinkReason String?        @map("unlink_reason")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?        @map("created_by") @db.Uuid
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?        @map("updated_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "party_user_link_tenant_id_fkey")
  party    Party         @relation(fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "party_user_link_party_id_fkey")
  user     UserAccount   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "party_user_link_user_id_fkey")
  identity UserIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "party_user_link_identity_id_fkey")

  // back-relations of app models (injected by asset-core prisma-fragment)
  partyLinkRequestLink PartyLinkRequest[] @relation("PartyLinkRequestLink")

  @@unique([partyId, userId], map: "party_user_link_party_id_user_id_key", where: raw("(state = 'active'::core.party_link_state)"))
  @@index([userId], map: "party_user_link_user_id_idx")
  @@index([tenantId], map: "party_user_link_tenant_id_idx")
  @@map("party_user_link")
  @@schema("core")
}

/// Who owns a unit, with share (Σ share_pct per unit per day ≤ 100, deferred trigger).
model UnitOwnership {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  buildingId String          @map("building_id") @db.Uuid
  unitId     String          @map("unit_id") @db.Uuid
  partyId    String          @map("party_id") @db.Uuid
  sharePct   Decimal         @map("share_pct") @db.Decimal(7, 4)
  validFrom  DateTime        @map("valid_from") @db.Date
  validTo    DateTime?       @map("valid_to") @db.Date
  source     OwnershipSource @default(manual)
  sourceRef  String?         @map("source_ref")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?         @map("created_by") @db.Uuid
  updatedAt  DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?         @map("updated_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_ownership_tenant_id_fkey")
  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_ownership_building_id_fkey")
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_ownership_unit_id_fkey")
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_ownership_party_id_fkey")

  @@index([partyId], map: "unit_ownership_party_id_idx")
  @@index([tenantId, buildingId], map: "unit_ownership_tenant_id_building_id_idx")
  @@index([unitId], map: "unit_ownership_unit_id_idx")
  @@map("unit_ownership")
  @@schema("core")
}

/// Who actually lives in a unit (role tenant = the lessee, D-151). lease_id is a logical reference.
model Occupancy {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  buildingId String        @map("building_id") @db.Uuid
  unitId     String        @map("unit_id") @db.Uuid
  partyId    String        @map("party_id") @db.Uuid
  role       OccupancyRole
  leaseId    String?       @map("lease_id") @db.Uuid
  validFrom  DateTime      @map("valid_from") @db.Date
  validTo    DateTime?     @map("valid_to") @db.Date
  movedInAt  DateTime?     @map("moved_in_at") @db.Timestamptz(6)
  movedOutAt DateTime?     @map("moved_out_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?       @map("created_by") @db.Uuid
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?       @map("updated_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "occupancy_tenant_id_fkey")
  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "occupancy_building_id_fkey")
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "occupancy_unit_id_fkey")
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "occupancy_party_id_fkey")

  @@index([partyId], map: "occupancy_party_id_idx")
  @@index([tenantId, buildingId, unitId], map: "occupancy_tenant_id_building_id_unit_id_idx")
  @@index([leaseId], map: "occupancy_lease_id_idx", where: raw("(lease_id IS NOT NULL)"))
  @@map("occupancy")
  @@schema("core")
}

/// Meters, gateways, locks, breakers, pumps, lifts, cameras, appliances … (unit_id null = common area).
model AssetItem {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  buildingId        String        @map("building_id") @db.Uuid
  floorId           String?       @map("floor_id") @db.Uuid
  unitId            String?       @map("unit_id") @db.Uuid
  category          AssetCategory
  name              String
  manufacturer      String?
  model             String?
  serial            String?       @db.Citext
  qrCode            String?       @map("qr_code")
  location          String?
  installDate       DateTime?     @map("install_date") @db.Date
  expectedLifeYears Decimal?      @map("expected_life_years") @db.Decimal(5, 2)
  warrantyUntil     DateTime?     @map("warranty_until") @db.Date
  warrantyPartyId   String?       @map("warranty_party_id") @db.Uuid
  status            AssetStatus   @default(active)
  retiredAt         DateTime?     @map("retired_at") @db.Timestamptz(6)
  retiredReason     String?       @map("retired_reason")
  meta              Json          @default("{}")
  sourceRef         String?       @map("source_ref")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?       @map("created_by") @db.Uuid
  updatedAt         DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?       @map("updated_by") @db.Uuid
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?       @map("deleted_by") @db.Uuid

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_item_tenant_id_fkey")
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_item_building_id_fkey")
  floor         Floor?   @relation(fields: [floorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_item_floor_id_fkey")
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_item_unit_id_fkey")
  warrantyParty Party?   @relation(fields: [warrantyPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_item_warranty_party_id_fkey")

  meterAssignments MeterAssignment[]

  // back-relations of app models (injected by asset-core prisma-fragment)
  deviceAssetItem             Device? @relation("DeviceAssetItem")
  estimateSettlementAssetItem EstimateSettlement[] @relation("EstimateSettlementAssetItem")
  inspectionItemMeter         InspectionItem[] @relation("InspectionItemMeter")
  invoiceLineAssetItem        InvoiceLine[] @relation("InvoiceLineAssetItem")
  lockAssetItem               Lock? @relation("LockAssetItem")
  lossSuspectAssetItem        LossSuspect[] @relation("LossSuspectAssetItem")
  maintenancePlanAssetItem    MaintenancePlan[] @relation("MaintenancePlanAssetItem")
  meterChannelMeter           MeterChannel[] @relation("MeterChannelMeter")
  meterReadingAssetItem       MeterReading[] @relation("MeterReadingAssetItem")
  meterStatusAssetItem        MeterStatus? @relation("MeterStatusAssetItem")
  readingRequestAssetItem     ReadingRequest[] @relation("ReadingRequestAssetItem")
  serviceRequestAssetItem     ServiceRequest[] @relation("ServiceRequestAssetItem")
  workOrderAssetItem          WorkOrder[] @relation("WorkOrderAssetItem")

  @@unique([buildingId, category, serial], map: "asset_item_building_id_category_serial_key", where: raw("((serial IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([tenantId, buildingId, category], map: "asset_item_tenant_id_building_id_category_idx")
  @@index([unitId], map: "asset_item_unit_id_idx")
  @@map("asset_item")
  @@schema("core")
}

/// A meter bound to a unit or a common area over time.
model MeterAssignment {
  id              String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  buildingId      String            @map("building_id") @db.Uuid
  assetItemId     String            @map("asset_item_id") @db.Uuid
  unitId          String?           @map("unit_id") @db.Uuid
  purpose         MeterPurpose
  utility         Utility
  code            String            @db.Citext
  commonAreaLabel String?           @map("common_area_label")
  validFrom       DateTime          @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime?         @map("valid_to") @db.Timestamptz(6)
  multiplier      Decimal           @default(1) @db.Decimal(12, 6)
  initialReading  Decimal           @default(0) @map("initial_reading") @db.Decimal(12, 3)
  finalReading    Decimal?          @map("final_reading") @db.Decimal(12, 3)
  rolloverAt      Decimal           @default(99999.999) @map("rollover_at") @db.Decimal(12, 3)
  closeReason     MeterCloseReason? @map("close_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?           @map("created_by") @db.Uuid
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?           @map("updated_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "meter_assignment_tenant_id_fkey")
  building  Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "meter_assignment_building_id_fkey")
  assetItem AssetItem @relation(fields: [assetItemId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "meter_assignment_asset_item_id_fkey")
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "meter_assignment_unit_id_fkey")

  // back-relations of app models (injected by asset-core prisma-fragment)
  estimateSettlementMeterAssignment EstimateSettlement[] @relation("EstimateSettlementMeterAssignment")
  invoiceLineMeterAssignment        InvoiceLine[] @relation("InvoiceLineMeterAssignment")
  meterReadingAssignment            MeterReading[] @relation("MeterReadingAssignment")
  meterSwapNewAssignment            MeterSwap? @relation("MeterSwapNewAssignment")
  meterSwapOldAssignment            MeterSwap? @relation("MeterSwapOldAssignment")
  readingRequestAssignment          ReadingRequest? @relation("ReadingRequestAssignment")

  @@unique([buildingId, code, validFrom], map: "meter_assignment_building_id_code_valid_from_key")
  @@index([tenantId, buildingId, utility, purpose], map: "meter_assignment_tenant_id_building_id_utility_purpose_idx")
  @@index([unitId], map: "meter_assignment_unit_id_idx")
  @@map("meter_assignment")
  @@schema("core")
}

/// Every stored file. tenant_id null = platform file (gp_platform only).
model Document {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String?             @map("tenant_id") @db.Uuid
  scopeType           DocumentScope       @map("scope_type")
  scopeId             String?             @map("scope_id") @db.Uuid
  buildingId          String?             @map("building_id") @db.Uuid
  kind                DocumentKind
  title               String?
  storageBucket       String              @map("storage_bucket")
  storageKey          String              @unique(map: "document_storage_key_key") @map("storage_key")
  mimeType            String              @map("mime_type")
  sizeBytes           BigInt              @map("size_bytes")
  sha256              Bytes
  width               Int?
  height              Int?
  versionOfDocumentId String?             @map("version_of_document_id") @db.Uuid
  versionNo           Int                 @default(1) @map("version_no")
  retentionClass      String              @map("retention_class")
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(6)
  scanStatus          DocumentScanStatus  @default(pending) @map("scan_status")
  scannedAt           DateTime?           @map("scanned_at") @db.Timestamptz(6)
  uploadState         DocumentUploadState @default(presigned) @map("upload_state")
  uploadedAt          DateTime?           @map("uploaded_at") @db.Timestamptz(6)
  thumbnailKey        String?             @map("thumbnail_key")
  sourceRef           String?             @map("source_ref")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?             @map("created_by") @db.Uuid
  updatedAt           DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?             @map("updated_by") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?             @map("deleted_by") @db.Uuid
  deleteReason        String?             @map("delete_reason")

  tenant     Tenant?    @relation("DocumentTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_tenant_id_fkey")
  building   Building?  @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_building_id_fkey")
  versionOf  Document?  @relation("DocumentVersions", fields: [versionOfDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "document_version_of_document_id_fkey")
  versions   Document[] @relation("DocumentVersions")
  logoOf     Tenant[]   @relation("TenantLogoDocument")
  floorPlans Floor[]    @relation("FloorPlanDocument")

  // back-relations of app models (injected by asset-core prisma-fragment)
  attachmentDocument                 Attachment[] @relation("AttachmentDocument")
  consentEvidenceDocument            Consent[] @relation("ConsentEvidenceDocument")
  creditNoteDocument                 CreditNote[] @relation("CreditNoteDocument")
  dataSubjectRequestExportDocument   DataSubjectRequest[] @relation("DataSubjectRequestExportDocument")
  debitNoteDocument                  DebitNote[] @relation("DebitNoteDocument")
  depositReceiptDocument             Deposit[] @relation("DepositReceiptDocument")
  depositSettlementRefundEvidence    DepositSettlement[] @relation("DepositSettlementRefundEvidence")
  depositSettlementStatementDocument DepositSettlement[] @relation("DepositSettlementStatementDocument")
  etaxSubmissionSignedPdfDocument    EtaxSubmission[] @relation("EtaxSubmissionSignedPdfDocument")
  etaxSubmissionSignedXmlDocument    EtaxSubmission[] @relation("EtaxSubmissionSignedXmlDocument")
  etaxSubmissionSourceDocument       EtaxSubmission[] @relation("EtaxSubmissionSourceDocument")
  exportJobFile                      ExportJob[] @relation("ExportJobFile")
  inspectionReportDocument           Inspection[] @relation("InspectionReportDocument")
  inspectionResidentSignature        Inspection[] @relation("InspectionResidentSignature")
  inspectionStaffSignature           Inspection[] @relation("InspectionStaffSignature")
  invoiceDocument                    Invoice[] @relation("InvoiceDocument")
  leaseContractDocument              Lease[] @relation("LeaseContractDocument")
  leaseSignatureImage                LeaseSignature[] @relation("LeaseSignatureImage")
  leaseSignaturePdf                  LeaseSignature[] @relation("LeaseSignaturePdf")
  leaseSignedDocument                Lease[] @relation("LeaseSignedDocument")
  meterReadingEvidence               MeterReading[] @relation("MeterReadingEvidence")
  otaReleaseArtifact                 OtaRelease[] @relation("OtaReleaseArtifact")
  parcelPhoto                        Parcel[] @relation("ParcelPhoto")
  paymentEvidenceDocument            Payment[] @relation("PaymentEvidenceDocument")
  paymentSettlementFileDocument      PaymentSettlementFile[] @relation("PaymentSettlementFileDocument")
  paymentSlipDocument                Payment[] @relation("PaymentSlipDocument")
  pilotAgreementDocument             PilotAgreement[] @relation("PilotAgreementDocument")
  platformCreditNoteDocument         PlatformCreditNote[] @relation("PlatformCreditNoteDocument")
  platformInvoiceDocument            PlatformInvoice[] @relation("PlatformInvoiceDocument")
  platformPaymentEvidence            PlatformPayment[] @relation("PlatformPaymentEvidence")
  platformReceiptDocument            PlatformReceipt[] @relation("PlatformReceiptDocument")
  receiptDocument                    Receipt[] @relation("ReceiptDocument")
  refundEvidenceDocument             Refund[] @relation("RefundEvidenceDocument")
  slipReviewDocument                 SlipReview[] @relation("SlipReviewDocument")
  taxInvoiceDocument                 TaxInvoice[] @relation("TaxInvoiceDocument")
  tm30ExportFileDocument             Tm30Export[] @relation("Tm30ExportFileDocument")
  utilityInvoiceDocument             UtilityInvoice[] @relation("UtilityInvoiceDocument")
  utilityTariffVersionSourceDocument UtilityTariffVersion[] @relation("UtilityTariffVersionSourceDocument")
  workOrderCostLineReceipt           WorkOrderCostLine[] @relation("WorkOrderCostLineReceipt")

  @@index([tenantId, scopeType, scopeId], map: "document_tenant_id_scope_type_scope_id_idx")
  @@index([tenantId, kind, createdAt], map: "document_tenant_id_kind_created_at_idx")
  @@index([expiresAt], map: "document_expires_at_idx", where: raw("(deleted_at IS NULL)"))
  @@index([sha256], map: "document_sha256_idx")
  @@map("document")
  @@schema("core")
}

/// The only way a tenant reads/writes another tenant's building or unit (D-152, §4.5).
model AssetAccessGrant {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  granteeTenantId String      @map("grantee_tenant_id") @db.Uuid
  buildingId      String      @map("building_id") @db.Uuid
  unitId          String?     @map("unit_id") @db.Uuid
  scope           GrantScope
  modules         String[]
  access          GrantAccess @default(read)
  reason          GrantReason
  validFrom       DateTime    @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo         DateTime?   @map("valid_to") @db.Timestamptz(6)
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokedBy       String?     @map("revoked_by") @db.Uuid
  revokeReason    String?     @map("revoke_reason")
  sourceRef       String?     @map("source_ref")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?     @map("created_by") @db.Uuid
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?     @map("updated_by") @db.Uuid

  tenant        Tenant   @relation("AssetAccessGrantTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_access_grant_tenant_id_fkey")
  granteeTenant Tenant   @relation("AssetAccessGrantGranteeTenant", fields: [granteeTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_access_grant_grantee_tenant_id_fkey")
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_access_grant_building_id_fkey")
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "asset_access_grant_unit_id_fkey")

  @@index([granteeTenantId, buildingId], map: "asset_access_grant_grantee_tenant_id_building_id_idx", where: raw("(revoked_at IS NULL)"))
  @@index([granteeTenantId, unitId], map: "asset_access_grant_grantee_tenant_id_unit_id_idx", where: raw("((revoked_at IS NULL) AND (unit_id IS NOT NULL))"))
  @@index([tenantId, buildingId], map: "asset_access_grant_tenant_id_building_id_idx")
  @@map("asset_access_grant")
  @@schema("core")
}

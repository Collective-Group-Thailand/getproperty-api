  workflowInstanceBuilding          WorkflowInstance[] @relation("WorkflowInstanceBuilding")
  workOrderBuilding                 WorkOrder[] @relation("WorkOrderBuilding")

  @@unique([propertyId, code], map: "building_property_id_code_key", where: raw("(deleted_at IS NULL)"))
  @@unique([sourceRef], map: "building_source_ref_key", where: raw("(source_ref IS NOT NULL)"))
  @@index([operatorTenantId], map: "building_operator_tenant_id_idx")

  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  code         String         @db.Citext
  name         String
  address      Json           @default("{}")
  provinceCode String?        @map("province_code")
  lat          Decimal?       @db.Decimal(9, 6)
  lng          Decimal?       @db.Decimal(9, 6)
  status       PropertyStatus @default(active)
  sourceRef    String?        @map("source_ref")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?        @map("created_by") @db.Uuid
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?        @map("updated_by") @db.Uuid
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?        @map("deleted_by") @db.Uuid
  version      Int            @default(1)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "property_tenant_id_fkey")
  buildings Building[]
  units     Unit[]

  // back-relations of app models (injected by asset-core prisma-fragment)
  billingCycleProperty           BillingCycle[] @relation("BillingCycleProperty")
  propertySettingVersionProperty PropertySettingVersion[] @relation("PropertySettingVersionProperty")

  @@unique([tenantId, code], map: "property_tenant_id_code_key", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, status], map: "property_tenant_id_status_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "property_name_trgm_idx")
  @@map("property")
  @@schema("core")
}

/// The unit of operation: owner vs operator tenant (§4.6).
model Building {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  propertyId       String         @map("property_id") @db.Uuid
  code             String         @db.Citext
  name             String
  type             BuildingType
  floorsCount      Int?           @map("floors_count") @db.SmallInt
  address          Json?
  ownerTenantId    String?        @map("owner_tenant_id") @db.Uuid
  operatorTenantId String         @map("operator_tenant_id") @db.Uuid
  registrationNo   String?        @map("registration_no")
  handedOverAt     DateTime?      @map("handed_over_at") @db.Timestamptz(6)
  sourceRef        String?        @map("source_ref")
  unitCountCached  Int            @default(0) @map("unit_count_cached")
  status           BuildingStatus @default(active)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?        @map("created_by") @db.Uuid
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?        @map("updated_by") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy        String?        @map("deleted_by") @db.Uuid
  version          Int            @default(1)

  tenant         Tenant   @relation("BuildingTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_tenant_id_fkey")
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_property_id_fkey")
  ownerTenant    Tenant?  @relation("BuildingOwnerTenant", fields: [ownerTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_owner_tenant_id_fkey")
  operatorTenant Tenant   @relation("BuildingOperatorTenant", fields: [operatorTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_operator_tenant_id_fkey")

  operatorPeriods  BuildingOperatorPeriod[]
  floors           Floor[]
  units            Unit[]
  unitOwnerships   UnitOwnership[]
  occupancies      Occupancy[]
  assetItems       AssetItem[]
  meterAssignments MeterAssignment[]
  documents        Document[]
  accessGrants     AssetAccessGrant[]

  // back-relations of app models (injected by asset-core prisma-fragment)
  accessCredentialBuilding          AccessCredential[] @relation("AccessCredentialBuilding")
  aiUsageRecordBuilding             AiUsageRecord[] @relation("AiUsageRecordBuilding")
  analyticsRollupBuilding           AnalyticsRollup[] @relation("AnalyticsRollupBuilding")
  announcementBuilding              Announcement[] @relation("AnnouncementBuilding")
  attachmentBuilding                Attachment[] @relation("AttachmentBuilding")
  buildingRuleBuilding              BuildingRule[] @relation("BuildingRuleBuilding")
  complianceAcknowledgementBuilding ComplianceAcknowledgement[] @relation("ComplianceAcknowledgementBuilding")
  complianceEvaluationBuilding      ComplianceEvaluation[] @relation("ComplianceEvaluationBuilding")
  contactBuilding                   Contact[] @relation("ContactBuilding")
  creditNoteBuilding                CreditNote[] @relation("CreditNoteBuilding")
  debitNoteBuilding                 DebitNote[] @relation("DebitNoteBuilding")
  depositBuilding                   Deposit[] @relation("DepositBuilding")
  depositSettlementBuilding         DepositSettlement[] @relation("DepositSettlementBuilding")
  deviceBuilding                    Device[] @relation("DeviceBuilding")
  deviceCommandBuilding             DeviceCommand[] @relation("DeviceCommandBuilding")
  deviceHealthLatestBuilding        DeviceHealthLatest[] @relation("DeviceHealthLatestBuilding")
  dunningReminderBuilding           DunningReminder[] @relation("DunningReminderBuilding")
  estimateSettlementBuilding        EstimateSettlement[] @relation("EstimateSettlementBuilding")
  etaxSubmissionBuilding            EtaxSubmission[] @relation("EtaxSubmissionBuilding")
  exportJobBuilding                 ExportJob[] @relation("ExportJobBuilding")
  facilityBookingBuilding           FacilityBooking[] @relation("FacilityBookingBuilding")
  facilityBuilding                  Facility[] @relation("FacilityBuilding")
  gatewayConfigBuilding             GatewayConfig[] @relation("GatewayConfigBuilding")
  haasAssetBuilding                 HaasAsset[] @relation("HaasAssetBuilding")
  inspectionBuilding                Inspection[] @relation("InspectionBuilding")
  installOrderBuilding              InstallOrder[] @relation("InstallOrderBuilding")
  integrationEventBuilding          IntegrationEvent[] @relation("IntegrationEventBuilding")
  invoiceBuilding                   Invoice[] @relation("InvoiceBuilding")
  invoiceChargeBuilding             InvoiceCharge[] @relation("InvoiceChargeBuilding")
  leaseBuilding                     Lease[] @relation("LeaseBuilding")
  lockBuilding                      Lock[] @relation("LockBuilding")
  lossReportBuilding                LossReport[] @relation("LossReportBuilding")
  maintenancePlanBuilding           MaintenancePlan[] @relation("MaintenancePlanBuilding")
  meterChannelBuilding              MeterChannel[] @relation("MeterChannelBuilding")
  meterReadingBuilding              MeterReading[] @relation("MeterReadingBuilding")
  meterReadingReviewBuilding        MeterReadingReview[] @relation("MeterReadingReviewBuilding")
  meterStatusBuilding               MeterStatus[] @relation("MeterStatusBuilding")
  meterSwapBuilding                 MeterSwap[] @relation("MeterSwapBuilding")
  parcelBuilding                    Parcel[] @relation("ParcelBuilding")
  payerCreditBuilding               PayerCredit[] @relation("PayerCreditBuilding")
  paymentBuilding                   Payment[] @relation("PaymentBuilding")
  paymentQrCodeBuilding             PaymentQrCode[] @relation("PaymentQrCodeBuilding")
  penaltyAssessmentBuilding         PenaltyAssessment[] @relation("PenaltyAssessmentBuilding")
  provisioningCodeBuilding          ProvisioningCode[] @relation("ProvisioningCodeBuilding")
  ratePlanBuilding                  RatePlan[] @relation("RatePlanBuilding")
  readingBatchBuilding              ReadingBatch[] @relation("ReadingBatchBuilding")
  readingRequestBuilding            ReadingRequest[] @relation("ReadingRequestBuilding")
  receiptBuilding                   Receipt[] @relation("ReceiptBuilding")
  receivableBalanceBuilding         ReceivableBalance[] @relation("ReceivableBalanceBuilding")
  receivableEntryBuilding           ReceivableEntry[] @relation("ReceivableEntryBuilding")
  refundBuilding                    Refund[] @relation("RefundBuilding")
  serviceMessageBuilding            ServiceMessage[] @relation("ServiceMessageBuilding")
  serviceRequestBuilding            ServiceRequest[] @relation("ServiceRequestBuilding")
  siteSurveyRequestBuilding         SiteSurveyRequest[] @relation("SiteSurveyRequestBuilding")
  slipReviewBuilding                SlipReview[] @relation("SlipReviewBuilding")
  taxInvoiceBuilding                TaxInvoice[] @relation("TaxInvoiceBuilding")
  tm30ExportBuilding                Tm30Export[] @relation("Tm30ExportBuilding")

  @@index([tenantId], map: "building_tenant_id_idx")
  @@map("building")
  @@schema("core")
}

/// History of owner/operator per building (closed rows immutable).
model BuildingOperatorPeriod {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  buildingId       String               @map("building_id") @db.Uuid
  ownerTenantId    String?              @map("owner_tenant_id") @db.Uuid
  operatorTenantId String               @map("operator_tenant_id") @db.Uuid
  validFrom        DateTime             @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime?            @map("valid_to") @db.Timestamptz(6)
  reason           OperatorChangeReason
  sourceRef        String?              @map("source_ref")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?              @map("created_by") @db.Uuid
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?              @map("updated_by") @db.Uuid

  tenant         Tenant   @relation("BuildingOperatorPeriodTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_operator_period_tenant_id_fkey")
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_operator_period_building_id_fkey")
  ownerTenant    Tenant?  @relation("BuildingOperatorPeriodOwnerTenant", fields: [ownerTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_operator_period_owner_tenant_id_fkey")
  operatorTenant Tenant   @relation("BuildingOperatorPeriodOperatorTenant", fields: [operatorTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "building_operator_period_operator_tenant_id_fkey")

  @@index([buildingId, validFrom], map: "building_operator_period_building_id_valid_from_idx")
  @@map("building_operator_period")
  @@schema("core")
}

model Floor {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  level          Int       @db.SmallInt
  name           String
  sortOrder      Int       @default(0) @map("sort_order") @db.SmallInt
  planDocumentId String?   @map("plan_document_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy      String?   @map("deleted_by") @db.Uuid

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "floor_tenant_id_fkey")
  building     Building  @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "floor_building_id_fkey")
  planDocument Document? @relation("FloorPlanDocument", fields: [planDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "floor_plan_document_id_fkey")
  units        Unit[]
  assetItems   AssetItem[]

  @@unique([buildingId, level], map: "floor_building_id_level_key", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, buildingId], map: "floor_tenant_id_building_id_idx")
  @@map("floor")
  @@schema("core")
}

/// Room / condo unit / house / shop / parking (D-151).
model Unit {
  id              String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  buildingId      String     @map("building_id") @db.Uuid
  propertyId      String     @map("property_id") @db.Uuid
  floorId         String?    @map("floor_id") @db.Uuid
  unitNo          String     @map("unit_no") @db.Citext
  type            UnitType   @default(room)
  areaSqm         Decimal?   @map("area_sqm") @db.Decimal(9, 2)
  ownershipRatio  Decimal?   @map("ownership_ratio") @db.Decimal(9, 6)
  status          UnitStatus @default(vacant)
  statusChangedAt DateTime   @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  baseRent        Decimal?   @map("base_rent") @db.Decimal(14, 2)
  titleDeedNo     String?    @map("title_deed_no")
  sourceRef       String?    @map("source_ref")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?    @map("created_by") @db.Uuid
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?    @map("updated_by") @db.Uuid
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?    @map("deleted_by") @db.Uuid
  version         Int        @default(1)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_tenant_id_fkey")
  building Building @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_building_id_fkey")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_property_id_fkey")
  floor    Floor?   @relation(fields: [floorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "unit_floor_id_fkey")

  ownerships       UnitOwnership[]
  occupancies      Occupancy[]
  assetItems       AssetItem[]
  meterAssignments MeterAssignment[]
  accessGrants     AssetAccessGrant[]

  // back-relations of app models (injected by asset-core prisma-fragment)
  accessCredentialUnit   AccessCredential[] @relation("AccessCredentialUnit")
  creditNoteUnit         CreditNote[] @relation("CreditNoteUnit")
  csatResponseUnit       CsatResponse[] @relation("CsatResponseUnit")
  debitNoteUnit          DebitNote[] @relation("DebitNoteUnit")
  depositSettlementUnit  DepositSettlement[] @relation("DepositSettlementUnit")
  depositUnit            Deposit[] @relation("DepositUnit")
  estimateSettlementUnit EstimateSettlement[] @relation("EstimateSettlementUnit")
  facilityBookingUnit    FacilityBooking[] @relation("FacilityBookingUnit")
  inspectionUnit         Inspection[] @relation("InspectionUnit")
  invoiceChargeUnit      InvoiceCharge[] @relation("InvoiceChargeUnit")
  invoiceUnit            Invoice[] @relation("InvoiceUnit")
  leaseUnit              Lease[] @relation("LeaseUnit")
  lockUnit               Lock[] @relation("LockUnit")
  lossSuspectUnit        LossSuspect[] @relation("LossSuspectUnit")
  meterReadingReviewUnit MeterReadingReview[] @relation("MeterReadingReviewUnit")
  meterReadingUnit       MeterReading[] @relation("MeterReadingUnit")
  meterSwapUnit          MeterSwap[] @relation("MeterSwapUnit")
  parcelUnit             Parcel[] @relation("ParcelUnit")
  payerCreditUnit        PayerCredit[] @relation("PayerCreditUnit")
  paymentQrCodeUnit      PaymentQrCode[] @relation("PaymentQrCodeUnit")
  paymentUnit            Payment[] @relation("PaymentUnit")
  penaltyAssessmentUnit  PenaltyAssessment[] @relation("PenaltyAssessmentUnit")
  receiptUnit            Receipt[] @relation("ReceiptUnit")
  receivableBalanceUnit  ReceivableBalance[] @relation("ReceivableBalanceUnit")
  receivableEntryUnit    ReceivableEntry[] @relation("ReceivableEntryUnit")
  refundUnit             Refund[] @relation("RefundUnit")
  serviceRequestUnit     ServiceRequest[] @relation("ServiceRequestUnit")
  slipReviewUnit         SlipReview[] @relation("SlipReviewUnit")
  taxInvoiceUnit         TaxInvoice[] @relation("TaxInvoiceUnit")
  tm30ExportUnit         Tm30Export[] @relation("Tm30ExportUnit")
  unitDetailUnit         UnitDetail? @relation("UnitDetailUnit")
  workOrderUnit          WorkOrder[] @relation("WorkOrderUnit")

  @@unique([buildingId, unitNo], map: "unit_building_id_unit_no_key", where: raw("(deleted_at IS NULL)"))
  @@index([tenantId, buildingId, status], map: "unit_tenant_id_building_id_status_idx")
  @@index([unitNo(ops: raw("gin_trgm_ops"))], type: Gin, map: "unit_unit_no_trgm_idx")
  @@index([floorId], map: "unit_floor_id_idx")
  @@map("unit")
  @@schema("core")
}

/// Any person or company (D-151). id_number_enc is encrypted with the tenant DEK (§4.7).
model Party {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  type              PartyType
  displayName       String          @map("display_name")
  firstName         String?         @map("first_name")
  lastName          String?         @map("last_name")
  companyName       String?         @map("company_name")
  taxId             String?         @map("tax_id")
  phoneE164         String?         @map("phone_e164")
  phoneHash         Bytes?          @map("phone_hash")
  email             String?         @db.Citext
  lineUserId        String?         @map("line_user_id")
  language          String          @default("th") @db.Char(2)
  nationality       String?         @db.Char(2)
  idDocumentType    IdDocumentType? @map("id_document_type")
  idNumberEnc       Bytes?          @map("id_number_enc")
  idNumberHash      Bytes?          @map("id_number_hash")
  idDocumentCountry String?         @map("id_document_country") @db.Char(2)
  idExpiresOn       DateTime?       @map("id_expires_on") @db.Date
  dateOfBirth       DateTime?       @map("date_of_birth") @db.Date
  gender            String?         @db.Char(1)
  address           Json?
  emergencyContact  Json?           @map("emergency_contact")
  notes             String?
  anonymisedAt      DateTime?       @map("anonymised_at") @db.Timestamptz(6)
  sourceRef         String?         @map("source_ref")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?         @map("updated_by") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  deletedBy         String?         @map("deleted_by") @db.Uuid
  version           Int             @default(1)

  tenant Tenant @relation("PartyTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "party_tenant_id_fkey")

  legalEntityOfTenants Tenant[]        @relation("TenantLegalParty")
  userLinks            PartyUserLink[]
  ownerships           UnitOwnership[]
  occupancies          Occupancy[]

/// An estimated meter line reconciled by the actual reading (D-012, D-031).
model EstimateSettlement {
  id                     String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId               String                   @map("tenant_id") @db.Uuid
  buildingId             String                   @map("building_id") @db.Uuid
  unitId                 String?                  @map("unit_id") @db.Uuid
  assetItemId            String                   @map("asset_item_id") @db.Uuid
  meterAssignmentId      String                   @map("meter_assignment_id") @db.Uuid
  estimatedReadingId     String                   @map("estimated_reading_id") @db.Uuid
  actualReadingId        String?                  @map("actual_reading_id") @db.Uuid
  estimatedInvoiceLineId String                   @unique(map: "estimate_settlement_estimated_invoice_line_id_key") @map("estimated_invoice_line_id") @db.Uuid
  estimatedUnits         Decimal                  @map("estimated_units") @db.Decimal(12, 3)
  actualUnits            Decimal?                 @map("actual_units") @db.Decimal(12, 3)
  deltaUnits             Decimal?                 @map("delta_units") @db.Decimal(12, 3)
  deltaAmount            Decimal?                 @map("delta_amount") @db.Decimal(14, 2)
  ratePlanVersionId      String                   @map("rate_plan_version_id") @db.Uuid
  utilityTariffVersionId String                   @map("utility_tariff_version_id") @db.Uuid
  status                 EstimateSettlementStatus @default(pending)
  settledInvoiceLineId   String?                  @map("settled_invoice_line_id") @db.Uuid
  settledNoteId          String?                  @map("settled_note_id") @db.Uuid
  settledAt              DateTime?                @map("settled_at") @db.Timestamptz(6)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?                  @map("created_by") @db.Uuid
  updatedAt              DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?                  @map("updated_by") @db.Uuid

  tenant               Tenant               @relation("EstimateSettlementTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_tenant_id_fkey")
  building             Building             @relation("EstimateSettlementBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_building_id_fkey")
  unit                 Unit?                @relation("EstimateSettlementUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_unit_id_fkey")
  assetItem            AssetItem            @relation("EstimateSettlementAssetItem", fields: [assetItemId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_asset_item_id_fkey")
  meterAssignment      MeterAssignment      @relation("EstimateSettlementMeterAssignment", fields: [meterAssignmentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_meter_assignment_id_fkey")
  estimatedReading     MeterReading         @relation("EstimateSettlementEstimatedReading", fields: [estimatedReadingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_estimated_reading_fkey")
  actualReading        MeterReading?        @relation("EstimateSettlementActualReading", fields: [actualReadingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_actual_reading_fkey")
  estimatedLine        InvoiceLine          @relation("EstimateSettlementEstimatedLine", fields: [estimatedInvoiceLineId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_estimated_line_fkey")
  settledLine          InvoiceLine?         @relation("EstimateSettlementSettledLine", fields: [settledInvoiceLineId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "estimate_settlement_settled_line_fkey")
  settledNote          CreditNote?          @relation(fields: [settledNoteId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_settled_note_fkey")
  ratePlanVersion      RatePlanVersion      @relation(fields: [ratePlanVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_rate_plan_version_fkey")
  utilityTariffVersion UtilityTariffVersion @relation("EstimateSettlementTariffVersion", fields: [utilityTariffVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "estimate_settlement_tariff_version_fkey")
  settlementLines      InvoiceLine[]        @relation("InvoiceLineEstimateSettlement")

  @@index([tenantId, status], map: "estimate_settlement_tenant_id_status_idx")
  @@index([buildingId], map: "estimate_settlement_building_id_idx")
  @@index([unitId], map: "estimate_settlement_unit_id_idx")
  @@index([meterAssignmentId], map: "estimate_settlement_meter_assignment_id_idx")
  @@index([assetItemId], map: "estimate_settlement_asset_item_id_idx")
  @@index([estimatedReadingId], map: "estimate_settlement_estimated_reading_id_idx")
  @@index([actualReadingId], map: "estimate_settlement_actual_reading_id_idx")
  @@index([settledInvoiceLineId], map: "estimate_settlement_settled_invoice_line_id_idx")
  @@index([settledNoteId], map: "estimate_settlement_settled_note_id_idx")
  @@index([ratePlanVersionId], map: "estimate_settlement_rate_plan_version_id_idx")
  @@index([utilityTariffVersionId], map: "estimate_settlement_utility_tariff_version_id_idx")
  @@map("estimate_settlement")
  @@schema("ops")
}

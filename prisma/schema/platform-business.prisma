/// Platform-owned hardware at a tenant (D-081 HaaS, meter rental D-156).
model HaasAsset {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId           String     @map("device_id") @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  buildingId         String?    @map("building_id") @db.Uuid
  subscriptionId     String?    @map("subscription_id") @db.Uuid
  kind               DeviceKind
  installedAt        DateTime?  @map("installed_at") @db.Date
  termMonths         Int        @map("term_months") @db.SmallInt
  termEnd            DateTime?  @map("term_end") @db.Date
  monthlyValue       Decimal    @map("monthly_value") @db.Decimal(14, 2)
  acquisitionCost    Decimal    @map("acquisition_cost") @db.Decimal(14, 2)
  depreciationMethod String     @default("straight_line") @map("depreciation_method")
  state              HaasState  @default(allocated)
  replacedByAssetId  String?    @map("replaced_by_asset_id") @db.Uuid
  deinstallOrderId   String?    @map("deinstall_order_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid
  updatedAt          DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?    @map("updated_by") @db.Uuid
  version            Int        @default(1)

  device         Device           @relation("HaasAssetDevice", fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_device_id_fkey")
  tenant         Tenant           @relation("HaasAssetTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_tenant_id_fkey")
  building       Building?        @relation("HaasAssetBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_building_id_fkey")
  subscription   Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_subscription_id_fkey")
  replacedBy     HaasAsset?       @relation("HaasAssetReplacement", fields: [replacedByAssetId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_replaced_by_asset_id_fkey")
  replaces       HaasAsset[]      @relation("HaasAssetReplacement")
  deinstallOrder InstallOrder?    @relation("HaasAssetDeinstallOrder", fields: [deinstallOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "haas_asset_deinstall_order_id_fkey")
  events         HaasAssetEvent[]

  @@index([deviceId], map: "haas_asset_device_id_idx")
  @@index([tenantId, state], map: "haas_asset_tenant_id_state_idx")
  @@index([buildingId], map: "haas_asset_building_id_idx")
  @@index([subscriptionId], map: "haas_asset_subscription_id_idx")
  @@index([replacedByAssetId], map: "haas_asset_replaced_by_asset_id_idx")
  @@index([deinstallOrderId], map: "haas_asset_deinstall_order_id_idx")
  @@unique([deviceId], map: "haas_asset_device_id_live_key", where: raw("(state <> ALL (ARRAY['replaced'::platform.haas_state, 'deinstalled'::platform.haas_state, 'written_off'::platform.haas_state]))"))
  @@map("haas_asset")
  @@schema("platform")
}

model HaasAssetEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  haasAssetId    String   @map("haas_asset_id") @db.Uuid

// platform — price plans, subscriptions, platform AR, HaaS, pilots and field orders (§3.2.10, B6.1; D-081–D-083, D-156).

enum PlanKind {
  software
  addon
  hardware_rental
  hardware_sale
  service

  @@map("plan_kind")
  @@schema("platform")
}

enum PlanBillingUnit {
  per_unit
  per_meter_point
  per_building
  per_tenant
  per_report
  per_package
  per_listing
  per_recipient
  per_deal
  percent_of_amount

  @@map("plan_billing_unit")
  @@schema("platform")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled

  @@map("subscription_status")
  @@schema("platform")
}

enum BillingPeriod {
  monthly
  annual

  @@map("billing_period")
  @@schema("platform")
}

enum PlatformInvoiceStatus {
  draft
  issued
  paid
  partially_paid
  overdue
  void
  credited

  @@map("platform_invoice_status")
  @@schema("platform")
}

enum PlatformInvoiceKind {
  first
  monthly
  adjustment
  purchase

  @@map("platform_invoice_kind")
  @@schema("platform")
}

enum PlatformLineKind {
  subscription
  addon
  setup
  hardware_rental
  hardware_sale
  ai_overage
  inspection
  discount
  adjustment
  storage
  boost
  success_fee
  co_broke_fee
  media_service
  messaging_addon
  sponsored_broadcast

  @@map("platform_line_kind")
  @@schema("platform")
}

enum PlatformPaymentMethod {
  qr
  bank_transfer
  card
  offset

  @@map("platform_payment_method")
  @@schema("platform")
}

enum PlatformPaymentState {
  confirmed
  reversed

  @@map("platform_payment_state")
  @@schema("platform")
}

enum PlatformCreditNoteState {
  requested
  issued
  rejected

  @@map("platform_credit_note_state")
  @@schema("platform")
}

enum HaasState {
  allocated
  installed
  in_service
  replaced
  deinstalled
  written_off

  @@map("haas_state")
  @@schema("platform")
}

enum SiteSurveyState {
  requested
  scheduled
  done
  cancelled

  @@map("site_survey_state")
  @@schema("platform")
}

enum InstallOrderKind {
  install
  deinstall
  replace
  site_survey

  @@map("install_order_kind")
  @@schema("platform")
}

enum InstallOrderState {
  open
  in_progress
  done
  cancelled

  @@map("install_order_state")
  @@schema("platform")
}

/// Plans of the platform (D-156); only active plans are sold.
model PricePlan {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key        String      @unique(map: "price_plan_key_key")
  tenantType TenantType? @map("tenant_type")
  nameTh     String      @map("name_th")
  nameEn     String      @map("name_en")
  kind       PlanKind
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?     @map("created_by") @db.Uuid
  updatedAt  DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?     @map("updated_by") @db.Uuid

  versions PricePlanVersion[]

  @@map("price_plan")
  @@schema("platform")
}

/// Effective-dated price of a plan (D-156 values, Proposed until the pilot); published versions never overlap or change.
model PricePlanVersion {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  planId             String               @map("plan_id") @db.Uuid
  version            Int
  effectiveFrom      DateTime             @map("effective_from") @db.Date
  effectiveTo        DateTime?            @map("effective_to") @db.Date
  billingUnit        PlanBillingUnit      @map("billing_unit")
  unitPrice          Decimal?             @map("unit_price") @db.Decimal(14, 4)
  priceRange         Json?                @map("price_range")
  tiers              Json                 @default("[]")
  minUnits           Int?                 @map("min_units")
  minMonthly         Decimal?             @map("min_monthly") @db.Decimal(14, 2)
  annualDiscountPct  Decimal              @default(15) @map("annual_discount_pct") @db.Decimal(7, 4)
  termMonths         Int?                 @map("term_months") @db.SmallInt
  setupFee           Decimal              @default(0) @map("setup_fee") @db.Decimal(14, 2)
  includedAllowances Json                 @default("{}") @map("included_allowances")
  vatRate            Decimal              @default(0.07) @map("vat_rate") @db.Decimal(5, 4)
  currency           String               @default("THB") @db.Char(3)
  terms              Json                 @default("{}")
  state              TemplateVersionState @default(draft)
  publishedBy        String?              @map("published_by") @db.Uuid
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?              @map("created_by") @db.Uuid
  updatedAt          DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?              @map("updated_by") @db.Uuid

  plan          PricePlan           @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "price_plan_version_plan_id_fkey")
  subscriptions   Subscription[]
  usages          SubscriptionUsage[]
  storagePackages StoragePackage[]

  @@unique([planId, version], map: "price_plan_version_plan_id_version_key")
  @@map("price_plan_version")
  @@schema("platform")
}

/// Pilot terms of a tenant (D-083).
model PilotAgreement {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String    @unique(map: "pilot_agreement_tenant_id_key") @map("tenant_id") @db.Uuid
  signedAt            DateTime  @map("signed_at") @db.Date
  discountPct         Decimal   @map("discount_pct") @db.Decimal(7, 4)
  termMonths          Int       @map("term_months") @db.SmallInt
  referenceSiteRights Boolean   @default(true) @map("reference_site_rights")
  anonymisedDataUse   Boolean   @default(true) @map("anonymised_data_use")
  feedbackCadence     String    @default("biweekly") @map("feedback_cadence")
  kpiReviewAt         DateTime  @map("kpi_review_at") @db.Date
  kpiTargets          Json      @default("{}") @map("kpi_targets")
  baseline            Json      @default("{}")
  agreementDocumentId String?   @map("agreement_document_id") @db.Uuid
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  tenant            Tenant         @relation("PilotAgreementTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pilot_agreement_tenant_id_fkey")
  agreementDocument Document?      @relation("PilotAgreementDocument", fields: [agreementDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "pilot_agreement_agreement_document_id_fkey")
  subscriptions     Subscription[]

  @@index([agreementDocumentId], map: "pilot_agreement_agreement_document_id_idx")
  @@map("pilot_agreement")
  @@schema("platform")
}

/// Platform field work per building (D-081): install / de-install / replace hardware and site surveys.
model InstallOrder {
  id                  String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  buildingId          String            @map("building_id") @db.Uuid
  kind                InstallOrderKind
  subscriptionId      String?           @map("subscription_id") @db.Uuid
  siteSurveyRequestId String?           @map("site_survey_request_id") @db.Uuid
  state               InstallOrderState @default(open)
  assignedTo          String?           @map("assigned_to") @db.Uuid
  dueAt               DateTime?         @map("due_at") @db.Timestamptz(6)
  items               Json              @default("[]")
  notes               String?
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?           @map("created_by") @db.Uuid
  updatedAt           DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?           @map("updated_by") @db.Uuid
  version             Int               @default(1)

  tenant             Tenant              @relation("InstallOrderTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "install_order_tenant_id_fkey")
  building           Building            @relation("InstallOrderBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "install_order_building_id_fkey")
  assignee           UserAccount?        @relation("InstallOrderAssignee", fields: [assignedTo], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "install_order_assigned_to_fkey")
  subscription       Subscription?       @relation("InstallOrderSubscription", fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "install_order_subscription_id_fkey")
  siteSurvey         SiteSurveyRequest?  @relation("InstallOrderSiteSurvey", fields: [siteSurveyRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "install_order_site_survey_request_id_fkey")
  surveysResultingIn SiteSurveyRequest[] @relation("SiteSurveyInstallOrder")
  deinstallOf        Subscription[]      @relation("SubscriptionDeinstallOrder")
  haasDeinstalls     HaasAsset[]         @relation("HaasAssetDeinstallOrder")
  haasEvents         HaasAssetEvent[]

  @@index([tenantId, state], map: "install_order_tenant_id_state_idx")
  @@index([buildingId], map: "install_order_building_id_idx")
  @@index([subscriptionId], map: "install_order_subscription_id_idx")
  @@index([siteSurveyRequestId], map: "install_order_site_survey_request_id_idx")
  @@index([assignedTo], map: "install_order_assigned_to_idx")
  @@map("install_order")
  @@schema("platform")
}

/// Upgrade Starter → Smart (D-156): the owner asks, a field engineer surveys, the outcome becomes an install order.
model SiteSurveyRequest {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  buildingId     String          @map("building_id") @db.Uuid
  requestedBy    String?         @map("requested_by") @db.Uuid
  targetPlanKey  String          @default("apartment_smart") @map("target_plan_key")
  state          SiteSurveyState @default(requested)
  scheduledFor   DateTime?       @map("scheduled_for") @db.Timestamptz(6)
  assignedTo     String?         @map("assigned_to") @db.Uuid
  findings       Json            @default("{}")
  notes          String?
  installOrderId String?         @map("install_order_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?         @map("updated_by") @db.Uuid
  version        Int             @default(1)

  tenant        Tenant         @relation("SiteSurveyRequestTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "site_survey_request_tenant_id_fkey")
  building      Building       @relation("SiteSurveyRequestBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "site_survey_request_building_id_fkey")
  requester     UserAccount?   @relation("SiteSurveyRequestRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "site_survey_request_requested_by_fkey")
  assignee      UserAccount?   @relation("SiteSurveyRequestAssignee", fields: [assignedTo], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "site_survey_request_assigned_to_fkey")
  installOrder  InstallOrder?  @relation("SiteSurveyInstallOrder", fields: [installOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "site_survey_request_install_order_id_fkey")
  installOrders InstallOrder[] @relation("InstallOrderSiteSurvey")

  @@index([tenantId, state], map: "site_survey_request_tenant_id_state_idx")
  @@index([buildingId], map: "site_survey_request_building_id_idx")
  @@index([requestedBy], map: "site_survey_request_requested_by_idx")
  @@index([assignedTo], map: "site_survey_request_assigned_to_idx")
  @@index([installOrderId], map: "site_survey_request_install_order_id_idx")
  @@map("site_survey_request")
  @@schema("platform")
}

/// A tenant's subscription (D-082): trial → active → past_due → suspended (read-only) → cancelled.
model Subscription {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  planVersionId       String             @map("plan_version_id") @db.Uuid
  planKey             String             @map("plan_key")
  addonPlanVersionIds String[]           @default([]) @map("addon_plan_version_ids") @db.Uuid
  state               SubscriptionStatus @default(trial)
  trialEndsAt         DateTime           @map("trial_ends_at") @db.Timestamptz(6)
  startedAt           DateTime           @map("started_at") @db.Timestamptz(6)
  activatedAt         DateTime?          @map("activated_at") @db.Timestamptz(6)
  termStart           DateTime?          @map("term_start") @db.Date
  termEnd             DateTime?          @map("term_end") @db.Date
  billingPeriod       BillingPeriod      @default(monthly) @map("billing_period")
  billingDay          Int                @default(1) @map("billing_day") @db.SmallInt
  nextInvoiceAt       DateTime?          @map("next_invoice_at") @db.Timestamptz(6)
  discountPct         Decimal            @default(0) @map("discount_pct") @db.Decimal(7, 4)
  discountReason      String?            @map("discount_reason")
  pilotAgreementId    String?            @map("pilot_agreement_id") @db.Uuid
  pastDueSince        DateTime?          @map("past_due_since") @db.Timestamptz(6)
  suspendedAt         DateTime?          @map("suspended_at") @db.Timestamptz(6)
  cancelledAt         DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?            @map("cancel_reason")
  cancelEffectiveDate DateTime?          @map("cancel_effective_date") @db.Date
  deinstallOrderId    String?            @map("deinstall_order_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?            @map("created_by") @db.Uuid
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?            @map("updated_by") @db.Uuid
  version             Int                @default(1)

  tenant         Tenant              @relation("SubscriptionTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_tenant_id_fkey")
  planVersion    PricePlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_plan_version_id_fkey")
  pilotAgreement PilotAgreement?     @relation(fields: [pilotAgreementId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_pilot_agreement_id_fkey")
  deinstallOrder InstallOrder?       @relation("SubscriptionDeinstallOrder", fields: [deinstallOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_deinstall_order_id_fkey")
  events         SubscriptionEvent[]
  usages         SubscriptionUsage[]
  invoices       PlatformInvoice[]
  installOrders  InstallOrder[]      @relation("InstallOrderSubscription")
  haasAssets     HaasAsset[]

  @@index([tenantId], map: "subscription_tenant_id_idx")
  @@index([planVersionId], map: "subscription_plan_version_id_idx")
  @@index([pilotAgreementId], map: "subscription_pilot_agreement_id_idx")
  @@index([deinstallOrderId], map: "subscription_deinstall_order_id_idx")
  @@index([state], map: "subscription_state_idx")
  @@unique([tenantId], map: "subscription_tenant_id_open_key", where: raw("(state = ANY (ARRAY['trial'::platform.subscription_status, 'active'::platform.subscription_status, 'past_due'::platform.subscription_status, 'suspended'::platform.subscription_status]))"))
  @@map("subscription")
  @@schema("platform")
}

/// History of a subscription. Append-only.
model SubscriptionEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  type           String
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actor          Json     @default("{}")
  data           Json     @default("{}")

  tenant       Tenant       @relation("SubscriptionEventTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_event_tenant_id_fkey")
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_event_subscription_id_fkey")

  @@index([subscriptionId, occurredAt], map: "subscription_event_subscription_id_occurred_at_idx")
  @@index([tenantId], map: "subscription_event_tenant_id_idx")
  @@map("subscription_event")
  @@schema("platform")
}

/// Monthly snapshot on the 1st (D-082, D-156): units counted, rented meter points, OCR images (D-161), amount.
model SubscriptionUsage {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  subscriptionId     String   @map("subscription_id") @db.Uuid
  month              DateTime @db.Date
  unitsCounted       Int      @map("units_counted")
  meterPointsCounted Int      @default(0) @map("meter_points_counted")
  ocrImages          Int      @default(0) @map("ocr_images")
  unitsByBuilding    Json     @default("{}") @map("units_by_building")
  planVersionId      String   @map("plan_version_id") @db.Uuid
  amountComputed     Decimal  @map("amount_computed") @db.Decimal(14, 2)
  lines              Json     @default("[]")
  snapshotAt         DateTime @map("snapshot_at") @db.Timestamptz(6)

  tenant       Tenant            @relation("SubscriptionUsageTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_usage_tenant_id_fkey")
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_usage_subscription_id_fkey")
  planVersion  PricePlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "subscription_usage_plan_version_id_fkey")
  invoices     PlatformInvoice[]

  @@unique([subscriptionId, month], map: "subscription_usage_subscription_id_month_key")
  @@index([tenantId], map: "subscription_usage_tenant_id_idx")
  @@index([planVersionId], map: "subscription_usage_plan_version_id_idx")
  @@map("subscription_usage")
  @@schema("platform")
}

/// Collective Group (Thailand) → tenant (D-146, D-156); immutable apart from payment state, QR and document.
model PlatformInvoice {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  subscriptionId String?               @map("subscription_id") @db.Uuid
  usageId        String?               @map("usage_id") @db.Uuid
  kind           PlatformInvoiceKind
  number         String                @unique(map: "platform_invoice_number_key") @db.Citext
  documentId     String?               @map("document_id") @db.Uuid
  periodStart    DateTime              @map("period_start") @db.Date
  periodEnd      DateTime              @map("period_end") @db.Date
  issuedAt       DateTime              @map("issued_at") @db.Timestamptz(6)
  dueAt          DateTime              @map("due_at") @db.Timestamptz(6)
  subtotal       Decimal               @db.Decimal(14, 2)
  discount       Decimal               @default(0) @db.Decimal(14, 2)
  vatAmount      Decimal               @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total          Decimal               @db.Decimal(14, 2)
  paidTotal      Decimal               @default(0) @map("paid_total") @db.Decimal(14, 2)
  creditedTotal  Decimal               @default(0) @map("credited_total") @db.Decimal(14, 2)
  state          PlatformInvoiceStatus @default(issued)
  overdueSince   DateTime?             @map("overdue_since") @db.Timestamptz(6)
  snapshot       Json                  @default("{}")
  qrPayload      String?               @map("qr_payload")
  qrReference    String?               @unique(map: "platform_invoice_qr_reference_key") @map("qr_reference")
  qrExpiresAt    DateTime?             @map("qr_expires_at") @db.Timestamptz(6)
  voidedAt       DateTime?             @map("voided_at") @db.Timestamptz(6)
  voidReason     String?               @map("void_reason")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?               @map("created_by") @db.Uuid
  updatedAt      DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int                   @default(1)

  tenant       Tenant                @relation("PlatformInvoiceTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_tenant_id_fkey")
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_subscription_id_fkey")
  usage        SubscriptionUsage?    @relation(fields: [usageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_usage_id_fkey")
  document     Document?             @relation("PlatformInvoiceDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_document_id_fkey")
  lines        PlatformInvoiceLine[]
  payments     PlatformPayment[]
  receipts     PlatformReceipt[]
  creditNotes  PlatformCreditNote[]
  storagePackages StoragePackage[]

  @@index([tenantId, state], map: "platform_invoice_tenant_id_state_idx")
  @@index([subscriptionId], map: "platform_invoice_subscription_id_idx")
  @@index([usageId], map: "platform_invoice_usage_id_idx")
  @@index([documentId], map: "platform_invoice_document_id_idx")
  @@unique([subscriptionId, kind, periodStart], map: "platform_invoice_subscription_period_key", where: raw("((kind <> 'adjustment'::platform.platform_invoice_kind) AND (state <> 'void'::platform.platform_invoice_status))"))
  @@map("platform_invoice")
  @@schema("platform")
}

model PlatformInvoiceLine {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  invoiceId   String           @map("invoice_id") @db.Uuid
  lineNo      Int              @map("line_no") @db.SmallInt
  kind        PlatformLineKind
  description String
  quantity    Decimal          @db.Decimal(12, 3)
  unitPrice   Decimal          @map("unit_price") @db.Decimal(14, 4)
  amount      Decimal          @db.Decimal(14, 2)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant          @relation("PlatformInvoiceLineTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_line_tenant_id_fkey")
  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "platform_invoice_line_invoice_id_fkey")

  @@unique([invoiceId, lineNo], map: "platform_invoice_line_invoice_id_line_no_key")
  @@index([tenantId], map: "platform_invoice_line_tenant_id_idx")
  @@map("platform_invoice_line")
  @@schema("platform")
}

/// Payments of platform invoices (platform QR callbacks or transfers recorded by Finance).
model PlatformPayment {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  invoiceId          String                @map("invoice_id") @db.Uuid
  amount             Decimal               @db.Decimal(14, 2)
  method             PlatformPaymentMethod
  provider           String?
  providerRef        String?               @map("provider_ref")
  paidAt             DateTime              @map("paid_at") @db.Timestamptz(6)
  confirmedAt        DateTime              @map("confirmed_at") @db.Timestamptz(6)
  state              PlatformPaymentState  @default(confirmed)
  recordedBy         String?               @map("recorded_by") @db.Uuid
  evidenceDocumentId String?               @map("evidence_document_id") @db.Uuid
  receiptId          String?               @map("receipt_id") @db.Uuid

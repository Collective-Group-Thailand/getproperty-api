// juristic schema (pack J, D-302–D-323). Tables arrive step by step; schema-design §7.6 drafts the rest.

/// D-303 (J1.1a): unearned revenue of an advance-billed invoice line spread over its calendar months (Σ = the line
/// amount); written at issue, recognised by J2.1.
model RevenueSchedule {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  invoiceLineId String    @map("invoice_line_id") @db.Uuid
  month         DateTime  @db.Date
  amount        Decimal   @db.Decimal(14, 2)
  recognisedAt  DateTime? @map("recognised_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid

  tenant      Tenant      @relation("RevenueScheduleTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_schedule_tenant_id_fkey")
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_schedule_invoice_line_id_fkey")

  @@unique([invoiceLineId, month], map: "revenue_schedule_invoice_line_id_month_key")
  @@index([tenantId, month], map: "revenue_schedule_tenant_id_month_idx")
  @@map("revenue_schedule")
  @@schema("juristic")
}

enum MeetingKind {
  agm
  egm
  committee

  @@map("meeting_kind")
  @@schema("juristic")
}

enum ResolutionState {
  draft
  adopted
  void

  @@map("resolution_state")
  @@schema("juristic")
}

enum ResolutionDocumentKind {
  minutes
  attachment
  notice

  @@map("resolution_document_kind")
  @@schema("juristic")
}

enum BudgetState {
  draft
  approved
  superseded

  @@map("budget_state")
  @@schema("juristic")
}

enum BudgetLineKind {
  income
  expense
  fund

  @@map("budget_line_kind")
  @@schema("juristic")
}

enum BillToKind {
  named_party
  agency

  @@map("bill_to_kind")
  @@schema("juristic")
}

enum TransferProration {
  carry_to_buyer
  refund_seller

  @@map("transfer_proration")
  @@schema("juristic")
}

/// D-304 (J1.1b): a meeting resolution (AGM / EGM / committee); draft → adopted → void.
model Resolution {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  buildingId   String          @map("building_id") @db.Uuid
  meetingKind  MeetingKind     @map("meeting_kind")
  meetingDate  DateTime        @map("meeting_date") @db.Date
  number       String
  title        String
  text         String
  votesSummary String?         @map("votes_summary")
  state        ResolutionState @default(draft)
  adoptedAt    DateTime?       @map("adopted_at") @db.Timestamptz(6)
  adoptedBy    String?         @map("adopted_by") @db.Uuid
  voidedAt     DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidReason   String?         @map("void_reason")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?         @map("updated_by") @db.Uuid
  version      Int             @default(1)

  tenant           Tenant               @relation("ResolutionTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_tenant_id_fkey")
  building         Building             @relation("ResolutionBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_building_id_fkey")
  documents        ResolutionDocument[]
  budgets          Budget[]
  ratePlanVersions RatePlanVersion[]

  @@unique([buildingId, meetingKind, number], map: "resolution_building_id_meeting_kind_number_key", where: raw("(state <> 'void'::juristic.resolution_state)"))
  @@index([tenantId, buildingId, meetingDate(sort: Desc)], map: "resolution_tenant_id_building_id_meeting_date_idx")
  @@map("resolution")
  @@schema("juristic")
}

/// D-304 (J1.1b): minutes, notices and attachments of a resolution.
model ResolutionDocument {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  resolutionId String                 @map("resolution_id") @db.Uuid
  documentId   String                 @map("document_id") @db.Uuid
  kind         ResolutionDocumentKind @default(attachment)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?                @map("created_by") @db.Uuid

  tenant     Tenant     @relation("ResolutionDocumentTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_document_tenant_id_fkey")
  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resolution_document_resolution_id_fkey")
  document   Document   @relation("ResolutionDocumentDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_document_document_id_fkey")

  @@unique([resolutionId, documentId], map: "resolution_document_resolution_id_document_id_key")
  @@index([documentId], map: "resolution_document_document_id_idx")
  @@map("resolution_document")
  @@schema("juristic")
}

/// D-304 (J1.1b): the annual budget of a building, approved with an adopted resolution.
model Budget {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  buildingId   String      @map("building_id") @db.Uuid
  fiscalYear   Int         @map("fiscal_year") @db.SmallInt
  name         String
  periodStart  DateTime    @map("period_start") @db.Date
  periodEnd    DateTime    @map("period_end") @db.Date
  state        BudgetState @default(draft)
  resolutionId String?     @map("resolution_id") @db.Uuid
  total        Decimal     @default(0) @db.Decimal(14, 2)
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?     @map("approved_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?     @map("created_by") @db.Uuid
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?     @map("updated_by") @db.Uuid
  version      Int         @default(1)

  tenant     Tenant       @relation("BudgetTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_tenant_id_fkey")
  building   Building     @relation("BudgetBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_building_id_fkey")
  resolution Resolution?  @relation(fields: [resolutionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_resolution_id_fkey")
  lines      BudgetLine[]

  @@unique([buildingId, fiscalYear], map: "budget_building_id_fiscal_year_approved_key", where: raw("(state = 'approved'::juristic.budget_state)"))
  @@unique([buildingId, fiscalYear], map: "budget_building_id_fiscal_year_draft_key", where: raw("(state = 'draft'::juristic.budget_state)"))
  @@index([tenantId, buildingId, fiscalYear(sort: Desc)], map: "budget_tenant_id_building_id_idx")
  @@index([resolutionId], map: "budget_resolution_id_idx")
  @@map("budget")
  @@schema("juristic")
}

/// D-304 (J1.1b): a budget line (income / expense / fund).
model BudgetLine {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  budgetId  String         @map("budget_id") @db.Uuid
  accountId String?        @map("account_id") @db.Uuid
  kind      BudgetLineKind @default(expense)
  label     String
  amount    Decimal        @db.Decimal(14, 2)
  sort      Int            @default(0) @db.SmallInt
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?        @map("created_by") @db.Uuid

  tenant Tenant @relation("BudgetLineTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_line_tenant_id_fkey")
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budget_line_budget_id_fkey")

  @@index([budgetId, sort], map: "budget_line_budget_id_idx")
  @@map("budget_line")
  @@schema("juristic")
}

/// D-307 (J1.1b): a co-owner names the party who receives and pays the unit's invoices (written consent).
model BillTo {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  buildingId        String     @map("building_id") @db.Uuid
  unitId            String     @map("unit_id") @db.Uuid
  ownerPartyId      String     @map("owner_party_id") @db.Uuid
  billToPartyId     String     @map("bill_to_party_id") @db.Uuid
  kind              BillToKind @default(named_party)
  consentDocumentId String     @map("consent_document_id") @db.Uuid
  consentNote       String?    @map("consent_note")
  validFrom         DateTime   @map("valid_from") @db.Date
  validTo           DateTime?  @map("valid_to") @db.Date
  endedReason       String?    @map("ended_reason")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?    @map("created_by") @db.Uuid
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?    @map("updated_by") @db.Uuid

  tenant          Tenant   @relation("BillToTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_tenant_id_fkey")
  building        Building @relation("BillToBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_building_id_fkey")
  unit            Unit     @relation("BillToUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_unit_id_fkey")
  ownerParty      Party    @relation("BillToOwnerParty", fields: [ownerPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_owner_party_id_fkey")
  billToParty     Party    @relation("BillToBillToParty", fields: [billToPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_bill_to_party_id_fkey")
  consentDocument Document @relation("BillToConsentDocument", fields: [consentDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_consent_document_id_fkey")

  @@index([unitId, validFrom], map: "bill_to_unit_id_idx")
  @@index([billToPartyId], map: "bill_to_bill_to_party_id_idx")
  @@index([ownerPartyId], map: "bill_to_owner_party_id_idx")
  @@map("bill_to")
  @@schema("juristic")
}

/// D-303 / D-324 (J1.1b): a recorded ownership transfer of a unit (append-only).
model OwnershipTransfer {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  buildingId       String            @map("building_id") @db.Uuid
  unitId           String            @map("unit_id") @db.Uuid
  transferDate     DateTime          @map("transfer_date") @db.Date
  fromOwnershipIds String[]          @map("from_ownership_ids") @db.Uuid
  toOwnershipIds   String[]          @map("to_ownership_ids") @db.Uuid
  policy           TransferProration
  creditNoteIds    String[]          @default([]) @map("credit_note_ids") @db.Uuid
  chargeIds        String[]          @default([]) @map("charge_ids") @db.Uuid
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?           @map("created_by") @db.Uuid

  tenant   Tenant   @relation("OwnershipTransferTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_tenant_id_fkey")
  building Building @relation("OwnershipTransferBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_building_id_fkey")
  unit     Unit     @relation("OwnershipTransferUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_unit_id_fkey")

  @@index([unitId, transferDate], map: "ownership_transfer_unit_id_transfer_date_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "ownership_transfer_tenant_id_idx")
  @@map("ownership_transfer")
  @@schema("juristic")
}

enum PaymentPlanState {
  proposed
  active
  completed
  defaulted
  cancelled
  rejected

  @@map("payment_plan_state")
  @@schema("juristic")
}

enum PlanProposer {
  staff
  resident

  @@map("plan_proposer")
  @@schema("juristic")
}

enum InstalmentState {
  scheduled
  billed
  paid
  cancelled

  @@map("instalment_state")
  @@schema("juristic")
}

/// D-308 / D-325 (J1.2a): an instalment plan of a party's open invoices of a unit.
model PaymentPlan {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  buildingId          String           @map("building_id") @db.Uuid
  unitId              String           @map("unit_id") @db.Uuid
  partyId             String           @map("party_id") @db.Uuid
  state               PaymentPlanState @default(proposed)
  proposedByKind      PlanProposer     @map("proposed_by_kind")
  requestedByUser     String?          @map("requested_by_user") @db.Uuid
  instalmentCount     Int              @map("instalment_count") @db.SmallInt
  firstDueOn          DateTime         @map("first_due_on") @db.Date
  proposedPrincipal   Decimal          @map("proposed_principal") @db.Decimal(14, 2)
  principal           Decimal?         @db.Decimal(14, 2)
  invoiceIds          String[]         @default([]) @map("invoice_ids") @db.Uuid
  creditNoteIds       String[]         @default([]) @map("credit_note_ids") @db.Uuid
  defaultAfterDays    Int?             @map("default_after_days") @db.SmallInt
  note                String?
  approvedAt          DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedBy          String?          @map("approved_by") @db.Uuid
  decidedReason       String?          @map("decided_reason")
  endedAt             DateTime?        @map("ended_at") @db.Timestamptz(6)
  acceleratedChargeId String?          @map("accelerated_charge_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?          @map("created_by") @db.Uuid
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?          @map("updated_by") @db.Uuid
  version             Int              @default(1)

  tenant            Tenant                  @relation("PaymentPlanTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_tenant_id_fkey")
  building          Building                @relation("PaymentPlanBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_building_id_fkey")
  unit              Unit                    @relation("PaymentPlanUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_unit_id_fkey")
  party             Party                   @relation("PaymentPlanParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_party_id_fkey")
  requester         UserAccount?            @relation("PaymentPlanRequester", fields: [requestedByUser], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_requested_by_user_fkey")
  acceleratedCharge InvoiceCharge?          @relation("PaymentPlanAcceleratedCharge", fields: [acceleratedChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_accelerated_charge_id_fkey")
  instalments       PaymentPlanInstalment[]

  @@unique([unitId, partyId], map: "payment_plan_open_key", where: raw("(state = ANY (ARRAY['proposed'::juristic.payment_plan_state, 'active'::juristic.payment_plan_state]))"))
  @@index([tenantId, state], map: "payment_plan_tenant_id_state_idx")
  @@index([partyId], map: "payment_plan_party_id_idx")
  @@map("payment_plan")
  @@schema("juristic")
}

/// D-325 (J1.2a): one instalment of a payment plan (charge line kind `plan_instalment`).
model PaymentPlanInstalment {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  seq             Int             @db.SmallInt
  dueOn           DateTime        @map("due_on") @db.Date
  amount          Decimal         @db.Decimal(14, 2)
  state           InstalmentState @default(scheduled)
  invoiceChargeId String?         @map("invoice_charge_id") @db.Uuid
  billedAt        DateTime?       @map("billed_at") @db.Timestamptz(6)
  paidAt          DateTime?       @map("paid_at") @db.Timestamptz(6)
  cancelledAt     DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation("PaymentPlanInstalmentTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_tenant_id_fkey")
  plan          PaymentPlan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_plan_id_fkey")
  invoiceCharge InvoiceCharge? @relation("PaymentPlanInstalmentCharge", fields: [invoiceChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_invoice_charge_id_fkey")

  @@unique([planId, seq], map: "payment_plan_instalment_plan_id_seq_key")
  @@index([state, dueOn], map: "payment_plan_instalment_state_due_on_idx")
  @@index([invoiceChargeId], map: "payment_plan_instalment_invoice_charge_id_idx")
  @@map("payment_plan_instalment")
  @@schema("juristic")
}

enum DebtClearanceState {
  requested
  issued
  refused

  @@map("debt_clearance_state")
  @@schema("juristic")
}

enum RequestChannel {
  liff
  web

  @@map("request_channel")
  @@schema("juristic")
}

/// D-306 / D-325 (J1.2a): debt clearance certificate (หนังสือรับรองการปลอดหนี้), series DCL.
model DebtClearance {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  buildingId     String             @map("building_id") @db.Uuid
  unitId         String             @map("unit_id") @db.Uuid
  partyId        String             @map("party_id") @db.Uuid
  requestedVia   RequestChannel     @map("requested_via")
  requestedBy    String?            @map("requested_by") @db.Uuid
  asOf           DateTime           @map("as_of") @db.Date
  language       String             @default("th") @db.Char(2)
  state          DebtClearanceState @default(requested)
  outstanding    Decimal            @default(0) @db.Decimal(14, 2)
  fee            Decimal            @default(0) @db.Decimal(14, 2)
  feeChargeId    String?            @map("fee_charge_id") @db.Uuid
  number         String?
  documentId     String?            @map("document_id") @db.Uuid
  verifyCodeHash Bytes?             @map("verify_code_hash")
  verifyCodeHint String?            @map("verify_code_hint")
  validUntil     DateTime?          @map("valid_until") @db.Date
  issuedAt       DateTime?          @map("issued_at") @db.Timestamptz(6)
  issuedBy       String?            @map("issued_by") @db.Uuid
  refusedAt      DateTime?          @map("refused_at") @db.Timestamptz(6)
  refusedBy      String?            @map("refused_by") @db.Uuid
  refuseReason   String?            @map("refuse_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int                @default(1)

  tenant    Tenant         @relation("DebtClearanceTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_tenant_id_fkey")
  building  Building       @relation("DebtClearanceBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_building_id_fkey")
  unit      Unit           @relation("DebtClearanceUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_unit_id_fkey")
  party     Party          @relation("DebtClearanceParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_party_id_fkey")
  requester UserAccount?   @relation("DebtClearanceRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_requested_by_fkey")
  document  Document?      @relation("DebtClearanceDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_document_id_fkey")
  feeCharge InvoiceCharge? @relation("DebtClearanceFeeCharge", fields: [feeChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_fee_charge_id_fkey")

  @@unique([tenantId, number], map: "debt_clearance_tenant_id_number_key", where: raw("(number IS NOT NULL)"))
  @@unique([verifyCodeHash], map: "debt_clearance_verify_code_hash_key", where: raw("(verify_code_hash IS NOT NULL)"))
  @@index([unitId, createdAt(sort: Desc)], map: "debt_clearance_unit_id_idx")
  @@index([tenantId, state], map: "debt_clearance_tenant_id_state_idx")
  @@index([partyId], map: "debt_clearance_party_id_idx")
  @@map("debt_clearance")
  @@schema("juristic")
}

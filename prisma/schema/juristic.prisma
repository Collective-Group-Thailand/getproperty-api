// juristic schema (pack J, D-302–D-323). Tables arrive step by step; schema-design §7.6 drafts the rest.

/// D-303 (J1.1a): unearned revenue of an advance-billed invoice line spread over its calendar months (Σ = the line
/// amount); written at issue, recognised by J2.1.
model RevenueSchedule {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  invoiceLineId String    @map("invoice_line_id") @db.Uuid
  month         DateTime  @db.Date
  amount        Decimal   @db.Decimal(14, 2)
  recognisedAt  DateTime? @map("recognised_at") @db.Timestamptz(6)
  recognisedAmount Decimal? @map("recognised_amount") @db.Decimal(14, 2)
  journalId     String?   @map("journal_id") @db.Uuid
  creditedAmount Decimal  @default(0) @map("credited_amount") @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid

  tenant      Tenant      @relation("RevenueScheduleTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_schedule_tenant_id_fkey")
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_schedule_invoice_line_id_fkey")
  journal     Journal?    @relation(fields: [journalId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "revenue_schedule_journal_id_fkey")

  @@unique([invoiceLineId, month], map: "revenue_schedule_invoice_line_id_month_key")
  @@index([tenantId, month], map: "revenue_schedule_tenant_id_month_idx")
  @@index([month], map: "revenue_schedule_due_idx", where: raw("(recognised_at IS NULL)"))
  @@index([journalId], map: "revenue_schedule_journal_id_idx", where: raw("(journal_id IS NOT NULL)"))
  @@map("revenue_schedule")
  @@schema("juristic")
}

enum MeetingKind {
  agm
  egm
  committee

  @@map("meeting_kind")
  @@schema("juristic")
}

enum ResolutionState {
  draft
  adopted
  void

  @@map("resolution_state")
  @@schema("juristic")
}

enum ResolutionDocumentKind {
  minutes
  attachment
  notice

  @@map("resolution_document_kind")
  @@schema("juristic")
}

enum BudgetState {
  draft
  approved
  superseded

  @@map("budget_state")
  @@schema("juristic")
}

enum BudgetLineKind {
  income
  expense
  fund

  @@map("budget_line_kind")
  @@schema("juristic")
}

enum BillToKind {
  named_party
  agency

  @@map("bill_to_kind")
  @@schema("juristic")
}

enum TransferProration {
  carry_to_buyer
  refund_seller

  @@map("transfer_proration")
  @@schema("juristic")
}

/// D-304 (J1.1b): a meeting resolution (AGM / EGM / committee); draft → adopted → void.
model Resolution {
  id           String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  buildingId   String          @map("building_id") @db.Uuid
  meetingKind  MeetingKind     @map("meeting_kind")
  meetingDate  DateTime        @map("meeting_date") @db.Date
  number       String
  title        String
  text         String
  votesSummary String?         @map("votes_summary")
  state        ResolutionState @default(draft)
  adoptedAt    DateTime?       @map("adopted_at") @db.Timestamptz(6)
  adoptedBy    String?         @map("adopted_by") @db.Uuid
  voidedAt     DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidReason   String?         @map("void_reason")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?         @map("created_by") @db.Uuid
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?         @map("updated_by") @db.Uuid
  version      Int             @default(1)

  tenant           Tenant               @relation("ResolutionTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_tenant_id_fkey")
  building         Building             @relation("ResolutionBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_building_id_fkey")
  documents        ResolutionDocument[]
  budgets          Budget[]
  ratePlanVersions RatePlanVersion[]
  journals         Journal[]
  fundTransfers    FundTransfer[]
  expenseRequests  ExpenseRequest[]
  quotationRounds  QuotationRound[]
  vendorContracts  VendorContract[]
  managementContracts ManagementContract[]

  @@unique([buildingId, meetingKind, number], map: "resolution_building_id_meeting_kind_number_key", where: raw("(state <> 'void'::juristic.resolution_state)"))
  @@index([tenantId, buildingId, meetingDate(sort: Desc)], map: "resolution_tenant_id_building_id_meeting_date_idx")
  @@map("resolution")
  @@schema("juristic")
}

/// D-304 (J1.1b): minutes, notices and attachments of a resolution.
model ResolutionDocument {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  resolutionId String                 @map("resolution_id") @db.Uuid
  documentId   String                 @map("document_id") @db.Uuid
  kind         ResolutionDocumentKind @default(attachment)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?                @map("created_by") @db.Uuid

  tenant     Tenant     @relation("ResolutionDocumentTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_document_tenant_id_fkey")
  resolution Resolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "resolution_document_resolution_id_fkey")
  document   Document   @relation("ResolutionDocumentDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "resolution_document_document_id_fkey")

  @@unique([resolutionId, documentId], map: "resolution_document_resolution_id_document_id_key")
  @@index([documentId], map: "resolution_document_document_id_idx")
  @@map("resolution_document")
  @@schema("juristic")
}

/// D-304 (J1.1b): the annual budget of a building, approved with an adopted resolution.
model Budget {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  buildingId   String      @map("building_id") @db.Uuid
  fiscalYear   Int         @map("fiscal_year") @db.SmallInt
  name         String
  periodStart  DateTime    @map("period_start") @db.Date
  periodEnd    DateTime    @map("period_end") @db.Date
  state        BudgetState @default(draft)
  resolutionId String?     @map("resolution_id") @db.Uuid
  total        Decimal     @default(0) @db.Decimal(14, 2)
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz(6)
  approvedBy   String?     @map("approved_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?     @map("created_by") @db.Uuid
  updatedAt    DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?     @map("updated_by") @db.Uuid
  version      Int         @default(1)

  tenant     Tenant       @relation("BudgetTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_tenant_id_fkey")
  building   Building     @relation("BudgetBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_building_id_fkey")
  resolution Resolution?  @relation(fields: [resolutionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_resolution_id_fkey")
  lines      BudgetLine[]

  @@unique([buildingId, fiscalYear], map: "budget_building_id_fiscal_year_approved_key", where: raw("(state = 'approved'::juristic.budget_state)"))
  @@unique([buildingId, fiscalYear], map: "budget_building_id_fiscal_year_draft_key", where: raw("(state = 'draft'::juristic.budget_state)"))
  @@index([tenantId, buildingId, fiscalYear(sort: Desc)], map: "budget_tenant_id_building_id_idx")
  @@index([resolutionId], map: "budget_resolution_id_idx")
  @@map("budget")
  @@schema("juristic")
}

/// D-304 (J1.1b): a budget line (income / expense / fund).
model BudgetLine {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  budgetId  String         @map("budget_id") @db.Uuid
  accountId String?        @map("account_id") @db.Uuid
  kind      BudgetLineKind @default(expense)
  label     String
  amount    Decimal        @db.Decimal(14, 2)
  sort      Int            @default(0) @db.SmallInt
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?        @map("created_by") @db.Uuid

  tenant Tenant @relation("BudgetLineTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_line_tenant_id_fkey")
  budget  Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "budget_line_budget_id_fkey")
  account Account? @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "budget_line_account_id_fkey")

  @@index([budgetId, sort], map: "budget_line_budget_id_idx")
  @@index([accountId], map: "budget_line_account_id_idx", where: raw("(account_id IS NOT NULL)"))
  @@map("budget_line")
  @@schema("juristic")
}

/// D-307 (J1.1b): a co-owner names the party who receives and pays the unit's invoices (written consent).
model BillTo {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  buildingId        String     @map("building_id") @db.Uuid
  unitId            String     @map("unit_id") @db.Uuid
  ownerPartyId      String     @map("owner_party_id") @db.Uuid
  billToPartyId     String     @map("bill_to_party_id") @db.Uuid
  kind              BillToKind @default(named_party)
  consentDocumentId String     @map("consent_document_id") @db.Uuid
  consentNote       String?    @map("consent_note")
  validFrom         DateTime   @map("valid_from") @db.Date
  validTo           DateTime?  @map("valid_to") @db.Date
  endedReason       String?    @map("ended_reason")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?    @map("created_by") @db.Uuid
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?    @map("updated_by") @db.Uuid

  tenant          Tenant   @relation("BillToTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_tenant_id_fkey")
  building        Building @relation("BillToBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_building_id_fkey")
  unit            Unit     @relation("BillToUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_unit_id_fkey")
  ownerParty      Party    @relation("BillToOwnerParty", fields: [ownerPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_owner_party_id_fkey")
  billToParty     Party    @relation("BillToBillToParty", fields: [billToPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_bill_to_party_id_fkey")
  consentDocument Document @relation("BillToConsentDocument", fields: [consentDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "bill_to_consent_document_id_fkey")

  @@index([unitId, validFrom], map: "bill_to_unit_id_idx")
  @@index([billToPartyId], map: "bill_to_bill_to_party_id_idx")
  @@index([ownerPartyId], map: "bill_to_owner_party_id_idx")
  @@map("bill_to")
  @@schema("juristic")
}

/// D-303 / D-324 (J1.1b): a recorded ownership transfer of a unit (append-only).
model OwnershipTransfer {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  buildingId       String            @map("building_id") @db.Uuid
  unitId           String            @map("unit_id") @db.Uuid
  transferDate     DateTime          @map("transfer_date") @db.Date
  fromOwnershipIds String[]          @map("from_ownership_ids") @db.Uuid
  toOwnershipIds   String[]          @map("to_ownership_ids") @db.Uuid
  policy           TransferProration
  creditNoteIds    String[]          @default([]) @map("credit_note_ids") @db.Uuid
  chargeIds        String[]          @default([]) @map("charge_ids") @db.Uuid
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?           @map("created_by") @db.Uuid

  tenant   Tenant   @relation("OwnershipTransferTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_tenant_id_fkey")
  building Building @relation("OwnershipTransferBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_building_id_fkey")
  unit     Unit     @relation("OwnershipTransferUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ownership_transfer_unit_id_fkey")

  @@index([unitId, transferDate], map: "ownership_transfer_unit_id_transfer_date_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "ownership_transfer_tenant_id_idx")
  @@map("ownership_transfer")
  @@schema("juristic")
}

enum PaymentPlanState {
  proposed
  active
  completed
  defaulted
  cancelled
  rejected

  @@map("payment_plan_state")
  @@schema("juristic")
}

enum PlanProposer {
  staff
  resident

  @@map("plan_proposer")
  @@schema("juristic")
}

enum InstalmentState {
  scheduled
  billed
  paid
  cancelled

  @@map("instalment_state")
  @@schema("juristic")
}

/// D-308 / D-325 (J1.2a): an instalment plan of a party's open invoices of a unit.
model PaymentPlan {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  buildingId          String           @map("building_id") @db.Uuid
  unitId              String           @map("unit_id") @db.Uuid
  partyId             String           @map("party_id") @db.Uuid
  state               PaymentPlanState @default(proposed)
  proposedByKind      PlanProposer     @map("proposed_by_kind")
  requestedByUser     String?          @map("requested_by_user") @db.Uuid
  instalmentCount     Int              @map("instalment_count") @db.SmallInt
  firstDueOn          DateTime         @map("first_due_on") @db.Date
  proposedPrincipal   Decimal          @map("proposed_principal") @db.Decimal(14, 2)
  principal           Decimal?         @db.Decimal(14, 2)
  invoiceIds          String[]         @default([]) @map("invoice_ids") @db.Uuid
  creditNoteIds       String[]         @default([]) @map("credit_note_ids") @db.Uuid
  defaultAfterDays    Int?             @map("default_after_days") @db.SmallInt
  note                String?
  approvedAt          DateTime?        @map("approved_at") @db.Timestamptz(6)
  approvedBy          String?          @map("approved_by") @db.Uuid
  decidedReason       String?          @map("decided_reason")
  endedAt             DateTime?        @map("ended_at") @db.Timestamptz(6)
  acceleratedChargeId String?          @map("accelerated_charge_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?          @map("created_by") @db.Uuid
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?          @map("updated_by") @db.Uuid
  version             Int              @default(1)

  tenant            Tenant                  @relation("PaymentPlanTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_tenant_id_fkey")
  building          Building                @relation("PaymentPlanBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_building_id_fkey")
  unit              Unit                    @relation("PaymentPlanUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_unit_id_fkey")
  party             Party                   @relation("PaymentPlanParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_party_id_fkey")
  requester         UserAccount?            @relation("PaymentPlanRequester", fields: [requestedByUser], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_requested_by_user_fkey")
  acceleratedCharge InvoiceCharge?          @relation("PaymentPlanAcceleratedCharge", fields: [acceleratedChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_accelerated_charge_id_fkey")
  instalments       PaymentPlanInstalment[]
  collectionCases   CollectionCase[]        @relation("CollectionCasePlan")

  @@unique([unitId, partyId], map: "payment_plan_open_key", where: raw("(state = ANY (ARRAY['proposed'::juristic.payment_plan_state, 'active'::juristic.payment_plan_state]))"))
  @@index([tenantId, state], map: "payment_plan_tenant_id_state_idx")
  @@index([partyId], map: "payment_plan_party_id_idx")
  @@map("payment_plan")
  @@schema("juristic")
}

/// D-325 (J1.2a): one instalment of a payment plan (charge line kind `plan_instalment`).
model PaymentPlanInstalment {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  seq             Int             @db.SmallInt
  dueOn           DateTime        @map("due_on") @db.Date
  amount          Decimal         @db.Decimal(14, 2)
  state           InstalmentState @default(scheduled)
  invoiceChargeId String?         @map("invoice_charge_id") @db.Uuid
  billedAt        DateTime?       @map("billed_at") @db.Timestamptz(6)
  paidAt          DateTime?       @map("paid_at") @db.Timestamptz(6)
  cancelledAt     DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation("PaymentPlanInstalmentTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_tenant_id_fkey")
  plan          PaymentPlan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_plan_id_fkey")
  invoiceCharge InvoiceCharge? @relation("PaymentPlanInstalmentCharge", fields: [invoiceChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payment_plan_instalment_invoice_charge_id_fkey")

  @@unique([planId, seq], map: "payment_plan_instalment_plan_id_seq_key")
  @@index([state, dueOn], map: "payment_plan_instalment_state_due_on_idx")
  @@index([invoiceChargeId], map: "payment_plan_instalment_invoice_charge_id_idx")
  @@map("payment_plan_instalment")
  @@schema("juristic")
}

enum DebtClearanceState {
  requested
  issued
  refused

  @@map("debt_clearance_state")
  @@schema("juristic")
}

enum RequestChannel {
  liff
  web

  @@map("request_channel")
  @@schema("juristic")
}

/// D-306 / D-325 (J1.2a): debt clearance certificate (หนังสือรับรองการปลอดหนี้), series DCL.
model DebtClearance {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  buildingId     String             @map("building_id") @db.Uuid
  unitId         String             @map("unit_id") @db.Uuid
  partyId        String             @map("party_id") @db.Uuid
  requestedVia   RequestChannel     @map("requested_via")
  requestedBy    String?            @map("requested_by") @db.Uuid
  asOf           DateTime           @map("as_of") @db.Date
  language       String             @default("th") @db.Char(2)
  state          DebtClearanceState @default(requested)
  outstanding    Decimal            @default(0) @db.Decimal(14, 2)
  fee            Decimal            @default(0) @db.Decimal(14, 2)
  feeChargeId    String?            @map("fee_charge_id") @db.Uuid
  number         String?
  documentId     String?            @map("document_id") @db.Uuid
  verifyCodeHash Bytes?             @map("verify_code_hash")
  verifyCodeHint String?            @map("verify_code_hint")
  validUntil     DateTime?          @map("valid_until") @db.Date
  issuedAt       DateTime?          @map("issued_at") @db.Timestamptz(6)
  issuedBy       String?            @map("issued_by") @db.Uuid
  refusedAt      DateTime?          @map("refused_at") @db.Timestamptz(6)
  refusedBy      String?            @map("refused_by") @db.Uuid
  refuseReason   String?            @map("refuse_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int                @default(1)

  tenant    Tenant         @relation("DebtClearanceTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_tenant_id_fkey")
  building  Building       @relation("DebtClearanceBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_building_id_fkey")
  unit      Unit           @relation("DebtClearanceUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_unit_id_fkey")
  party     Party          @relation("DebtClearanceParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_party_id_fkey")
  requester UserAccount?   @relation("DebtClearanceRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_requested_by_fkey")
  document  Document?      @relation("DebtClearanceDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_document_id_fkey")
  feeCharge InvoiceCharge? @relation("DebtClearanceFeeCharge", fields: [feeChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "debt_clearance_fee_charge_id_fkey")

  @@unique([tenantId, number], map: "debt_clearance_tenant_id_number_key", where: raw("(number IS NOT NULL)"))
  @@unique([verifyCodeHash], map: "debt_clearance_verify_code_hash_key", where: raw("(verify_code_hash IS NOT NULL)"))
  @@index([unitId, createdAt(sort: Desc)], map: "debt_clearance_unit_id_idx")
  @@index([tenantId, state], map: "debt_clearance_tenant_id_state_idx")
  @@index([partyId], map: "debt_clearance_party_id_idx")
  @@map("debt_clearance")
  @@schema("juristic")
}

// ------------------------------------------------------------------------------------------- J1.2b (D-305, D-307, D-270, D-326; migration 0073)

enum CollectionAction {
  remind
  surcharge
  notice_letter
  suspend_services
  lawyer_letter
  legal_action

  @@map("collection_action")
  @@schema("juristic")
}

enum CollectionChannel {
  line
  email
  sms
  letter

  @@map("collection_channel")
  @@schema("juristic")
}

enum CollectionCaseState {
  open
  paused
  resolved

  @@map("collection_case_state")
  @@schema("juristic")
}

enum CollectionEventKind {
  opened
  step
  paused
  resumed
  dispute_opened
  dispute_closed
  resolved

  @@map("collection_event_kind")
  @@schema("juristic")
}

enum CollectionOutcome {
  sent
  skipped
  awaiting_approval
  approved
  refused
  failed

  @@map("collection_outcome")
  @@schema("juristic")
}

enum LetterBatchState {
  queued
  ready
  failed

  @@map("letter_batch_state")
  @@schema("juristic")
}

enum WorkspaceLinkState {
  invited
  active
  revoked

  @@map("workspace_link_state")
  @@schema("juristic")
}

/// D-305 / D-326 (J1.2b): the collections ladder of a juristic tenant for one building legal form (from the template).
model CollectionLadder {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  legalForm         BuildingLegalForm @map("legal_form")
  name              String
  sourceTemplateKey String            @map("source_template_key")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?           @map("created_by") @db.Uuid
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?           @map("updated_by") @db.Uuid
  version           Int               @default(1)

  tenant Tenant           @relation("CollectionLadderTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_ladder_tenant_id_fkey")
  steps  CollectionStep[]
  cases  CollectionCase[]

  @@unique([tenantId, legalForm], map: "collection_ladder_tenant_id_legal_form_key")
  @@map("collection_ladder")
  @@schema("juristic")
}

/// D-305 / D-326: one step of a ladder (offset after the oldest due date, action, channels, template, approval).
model CollectionStep {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  ladderId         String              @map("ladder_id") @db.Uuid
  seq              Int                 @db.SmallInt
  offsetDays       Int                 @map("offset_days")
  action           CollectionAction
  channels         CollectionChannel[] @default([])
  templateKey      String              @map("template_key")
  requiresApproval Boolean             @default(false) @map("requires_approval")
  enabled          Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?             @map("updated_by") @db.Uuid
  version          Int                 @default(1)

  tenant        Tenant            @relation("CollectionStepTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_step_tenant_id_fkey")
  ladder        CollectionLadder  @relation(fields: [ladderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "collection_step_ladder_id_fkey")
  awaitingCases CollectionCase[]  @relation("CollectionCaseAwaitingStep")
  events        CollectionEvent[]

  @@unique([ladderId, seq], map: "collection_step_ladder_id_seq_key")
  @@map("collection_step")
  @@schema("juristic")
}

/// D-305 / D-326: the collections of one billed party for one unit (open → paused ⇄ open → resolved).
model CollectionCase {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  buildingId         String              @map("building_id") @db.Uuid
  unitId             String              @map("unit_id") @db.Uuid
  partyId            String              @map("party_id") @db.Uuid
  ladderId           String              @map("ladder_id") @db.Uuid
  legalForm          BuildingLegalForm   @map("legal_form")
  state              CollectionCaseState @default(open)
  anchorOn           DateTime            @map("anchor_on") @db.Date
  openedAt           DateTime            @default(now()) @map("opened_at") @db.Timestamptz(6)
  nextSeq            Int                 @default(1) @map("next_seq") @db.SmallInt
  awaitingStepId     String?             @map("awaiting_step_id") @db.Uuid
  planId             String?             @map("plan_id") @db.Uuid
  disputeOpenedAt    DateTime?           @map("dispute_opened_at") @db.Timestamptz(6)
  disputeReason      String?             @map("dispute_reason")
  pausedAt           DateTime?           @map("paused_at") @db.Timestamptz(6)
  pausedDays         Int                 @default(0) @map("paused_days")
  surchargedThrough  DateTime?           @map("surcharged_through") @db.Date
  resolvedAt         DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolveReason      String?             @map("resolve_reason")
  workflowInstanceId String?             @map("workflow_instance_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                 @default(1)

  tenant           Tenant            @relation("CollectionCaseTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_tenant_id_fkey")
  building         Building          @relation("CollectionCaseBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_building_id_fkey")
  unit             Unit              @relation("CollectionCaseUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_unit_id_fkey")
  party            Party             @relation("CollectionCaseParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_party_id_fkey")
  ladder           CollectionLadder  @relation(fields: [ladderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_ladder_id_fkey")
  awaitingStep     CollectionStep?   @relation("CollectionCaseAwaitingStep", fields: [awaitingStepId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_awaiting_step_id_fkey")
  plan             PaymentPlan?      @relation("CollectionCasePlan", fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_plan_id_fkey")
  workflowInstance WorkflowInstance? @relation("CollectionCaseWorkflow", fields: [workflowInstanceId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_case_workflow_instance_id_fkey")
  events           CollectionEvent[]

  @@unique([partyId, unitId], map: "collection_case_open_key", where: raw("(state = ANY (ARRAY['open'::juristic.collection_case_state, 'paused'::juristic.collection_case_state]))"))
  @@index([tenantId, state], map: "collection_case_tenant_id_state_idx")
  @@index([unitId], map: "collection_case_unit_id_idx")
  @@index([planId], map: "collection_case_plan_id_idx", where: raw("(plan_id IS NOT NULL)"))
  @@map("collection_case")
  @@schema("juristic")
}

/// D-305 / D-326: append-only timeline of a collection case; each step has at most one final outcome.
model CollectionEvent {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  caseId          String              @map("case_id") @db.Uuid
  kind            CollectionEventKind
  stepId          String?             @map("step_id") @db.Uuid
  seq             Int?                @db.SmallInt
  action          CollectionAction?
  outcome         CollectionOutcome?
  reason          String?
  amount          Decimal?            @db.Decimal(14, 2)
  invoiceChargeId String?             @map("invoice_charge_id") @db.Uuid
  documentId      String?             @map("document_id") @db.Uuid
  actorUserId     String?             @map("actor_user_id") @db.Uuid
  payload         Json                @default("{}")
  occurredAt      DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant        Tenant          @relation("CollectionEventTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_tenant_id_fkey")
  case          CollectionCase  @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_case_id_fkey")
  step          CollectionStep? @relation(fields: [stepId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_step_id_fkey")
  invoiceCharge InvoiceCharge?  @relation("CollectionEventCharge", fields: [invoiceChargeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_invoice_charge_id_fkey")
  document      Document?       @relation("CollectionEventDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_document_id_fkey")
  actor         UserAccount?    @relation("CollectionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "collection_event_actor_user_id_fkey")

  @@unique([caseId, stepId], map: "collection_event_step_final_key", where: raw("((kind = 'step'::juristic.collection_event_kind) AND (outcome = ANY (ARRAY['sent'::juristic.collection_outcome, 'skipped'::juristic.collection_outcome, 'refused'::juristic.collection_outcome, 'failed'::juristic.collection_outcome])))"))
  @@unique([caseId, stepId, outcome], map: "collection_event_step_outcome_key", where: raw("(kind = 'step'::juristic.collection_event_kind)"))
  @@index([caseId, occurredAt], map: "collection_event_case_id_occurred_at_idx")
  @@index([tenantId, occurredAt(sort: Desc)], map: "collection_event_tenant_id_occurred_at_idx")
  @@map("collection_event")
  @@schema("juristic")
}

/// D-307 / D-326: printable letters (A4, address window) of a month's statements for owners without digital channels.
model LetterBatch {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  periodKey    String           @map("period_key")
  state        LetterBatchState @default(queued)
  statementIds String[]         @default([]) @map("statement_ids") @db.Uuid
  documentId   String?          @map("document_id") @db.Uuid
  error        String?
  requestedBy  String?          @map("requested_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime?        @map("finished_at") @db.Timestamptz(6)

  tenant     Tenant       @relation("LetterBatchTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "letter_batch_tenant_id_fkey")
  document   Document?    @relation("LetterBatchDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "letter_batch_document_id_fkey")
  requester  UserAccount? @relation("LetterBatchRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "letter_batch_requested_by_fkey")
  statements Statement[]

  @@index([tenantId, createdAt(sort: Desc)], map: "letter_batch_tenant_id_created_at_idx")
  @@map("letter_batch")
  @@schema("juristic")
}

/// D-307 / D-326: the monthly statement of one owner party across all their units in the tenant (series STM).
model Statement {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  partyId       String       @map("party_id") @db.Uuid
  number        String
  periodKey     String       @map("period_key")
  periodStart   DateTime     @map("period_start") @db.Date
  periodEnd     DateTime     @map("period_end") @db.Date
  language      String       @default("th") @db.Char(2)
  unitIds       String[]     @default([]) @map("unit_ids") @db.Uuid
  invoiceIds    String[]     @default([]) @map("invoice_ids") @db.Uuid
  opening       Decimal      @db.Decimal(14, 2)
  charges       Decimal      @db.Decimal(14, 2)
  credits       Decimal      @db.Decimal(14, 2)
  payments      Decimal      @db.Decimal(14, 2)
  closing       Decimal      @db.Decimal(14, 2)
  amountDue     Decimal      @map("amount_due") @db.Decimal(14, 2)
  snapshot      Json         @default("{}")
  documentId    String?      @map("document_id") @db.Uuid
  deliveredVia  String[]     @default([]) @map("delivered_via")
  letterBatchId String?      @map("letter_batch_id") @db.Uuid
  paymentIds    String[]     @default([]) @map("payment_ids") @db.Uuid
  issuedAt      DateTime     @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy      String?      @map("issued_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation("StatementTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "statement_tenant_id_fkey")
  party       Party        @relation("StatementParty", fields: [partyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "statement_party_id_fkey")
  document    Document?    @relation("StatementDocument", fields: [documentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "statement_document_id_fkey")
  letterBatch LetterBatch? @relation(fields: [letterBatchId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "statement_letter_batch_id_fkey")
  issuer      UserAccount? @relation("StatementIssuer", fields: [issuedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "statement_issued_by_fkey")

  @@unique([tenantId, partyId, periodStart], map: "statement_tenant_id_party_id_period_key")
  @@unique([tenantId, number], map: "statement_tenant_id_number_key")
  @@index([tenantId, periodKey], map: "statement_tenant_id_period_key_idx")
  @@index([partyId], map: "statement_party_id_idx")
  @@map("statement")
  @@schema("juristic")
}

/// D-270 / D-326: a landlord's invitation of its condo's juristic office for its units in a stub building.
model WorkspaceLink {
  id               String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  buildingId       String             @map("building_id") @db.Uuid
  unitIds          String[]           @map("unit_ids") @db.Uuid
  officeName       String             @map("office_name")
  officePhone      String?            @map("office_phone")
  state            WorkspaceLinkState @default(invited)
  codeHash         Bytes              @map("code_hash")
  codeHint         String             @map("code_hint")
  expiresAt        DateTime           @map("expires_at") @db.Timestamptz(6)
  juristicTenantId String?            @map("juristic_tenant_id") @db.Uuid
  landlordPartyId  String?            @map("landlord_party_id") @db.Uuid
  grantIds         String[]           @default([]) @map("grant_ids") @db.Uuid
  invitedBy        String?            @map("invited_by") @db.Uuid
  acceptedAt       DateTime?          @map("accepted_at") @db.Timestamptz(6)
  acceptedBy       String?            @map("accepted_by") @db.Uuid
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?            @map("revoke_reason")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int                @default(1)

  tenant         Tenant       @relation("WorkspaceLinkTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_tenant_id_fkey")
  building       Building     @relation("WorkspaceLinkBuilding", fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_building_id_fkey")
  juristicTenant Tenant?      @relation("WorkspaceLinkJuristicTenant", fields: [juristicTenantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_juristic_tenant_id_fkey")
  landlordParty  Party?       @relation("WorkspaceLinkLandlordParty", fields: [landlordPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_landlord_party_id_fkey")
  inviter        UserAccount? @relation("WorkspaceLinkInviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_invited_by_fkey")
  accepter       UserAccount? @relation("WorkspaceLinkAccepter", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "workspace_link_accepted_by_fkey")

  @@unique([codeHash], map: "workspace_link_code_hash_key")
  @@index([tenantId, state], map: "workspace_link_tenant_id_state_idx")
  @@index([juristicTenantId], map: "workspace_link_juristic_tenant_id_idx", where: raw("(juristic_tenant_id IS NOT NULL)"))
  @@map("workspace_link")
  @@schema("juristic")
}

# getproperty-api environment. Copy to `.env` for local development (`cp .env.example .env`).
# Every variable is validated at start-up (src/config/env.schema.ts); the process exits listing
# every invalid variable. Business values are NOT configured here — they are effective-dated
# settings in the database (ADR-0004).

# --- Runtime -------------------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port of the API process.
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable single-line logs (development only; production logs are JSON).
LOG_PRETTY=true
# Public origin of this API (links in documents and LINE messages); no trailing slash. Must not be localhost in production.
PUBLIC_API_BASE_URL=http://localhost:3000

# --- Modes -----------------------------------------------------------------------------------------
# fake = in-memory fakes for every third-party provider (S3, Secrets Manager, later LINE/SMS/QR…): tests,
#        `pnpm dev` without AWS, the contract build. real = AWS and providers. Must be `real` in production.
INTEGRATIONS_MODE=fake
# Optional per-provider override for S3 only (fake | real); empty = follow INTEGRATIONS_MODE.
OBJECT_STORAGE_MODE=
# Optional override for the PDF renderer only (fake | real); empty = follow INTEGRATIONS_MODE.
PDF_RENDERER_MODE=
# fake = PostgreSQL, Redis and the MQTT broker are in-memory stand-ins: no connection is opened, /health
#        reports each as `up` with `mode: fake`, idempotency keys live in memory, the worker idles, the
#        ingest process reads a fake broker. Used by unit/e2e tests (no Docker) and the contract build.
# real = connect to the stores below (docker compose up -d). Must be `real` in production.
DATA_STORES_MODE=fake
# Optional per-store overrides (fake | real); empty = follow DATA_STORES_MODE. `REDIS_MODE=fake` with a real
# PostgreSQL runs BullMQ on the in-memory queue (the worker ticks every second in-process); the integration suite
# uses it. Never fake in production.
REDIS_MODE=
MQTT_MODE=

# --- Data stores (required when DATA_STORES_MODE=real; docker-compose.yml) ---------------------------
# PostgreSQL 18 (ADR-0001 as amended by D-162: TimescaleDB optional). Without Docker: `pnpm db:local` starts an
# embedded cluster and prints DATABASE_URL=postgresql://gp:gp@127.0.0.1:55432/getproperty (+ the shadow URL).
# `pnpm db:migrate` = @collective/asset-core migrations (schema core) then `prisma migrate deploy` (ADR-0011).
DATABASE_URL=postgresql://getproperty:getproperty@localhost:5432/getproperty
# Shadow database for `prisma migrate dev` / drift checks (created by docker/postgres/init-shadow-db.sql or db:local);
# Prisma initialises it with the asset-core SQL first (prisma.config.ts migrations.initShadowDb).
SHADOW_DATABASE_URL=postgresql://getproperty:getproperty@localhost:5432/getproperty_shadow
# Row-level security (D-152): the app must run as gp_app (NOBYPASSRLS). In production the login user is a member
# of gp_app and this stays empty. Locally (superuser login) set it to gp_app so every tenant transaction runs
# `SET LOCAL ROLE gp_app` and RLS really applies.
DATABASE_APP_ROLE=gp_app
# BYPASSRLS role for identity lookups, the admin surface, the outbox relay and cross-tenant jobs (schema-design §4.5).
# Same rule as DATABASE_APP_ROLE: empty when the production login is a member of gp_platform; gp_platform locally.
DATABASE_PLATFORM_ROLE=gp_platform
# `node dist/src/migrate.js` (the image's migrate command): the optional TimescaleDB step of D-162 — auto (apply where
# the extension is usable, e.g. the platform's timescaledb-ha) | on (require it) | off.
TIMESCALEDB_MIGRATION=auto
# The same command then runs the idempotent reference seed (`pnpm db:seed`); false skips it.
SEED_REFERENCE=true
# Redis: BullMQ, idempotency fast path, caches.
REDIS_URL=redis://localhost:6379

# --- MQTT broker (EMQX, D-130) -------------------------------------------------------------------------
# mqtt:// (dev), mqtts:// (TLS, production), ws:// / wss:// (WebSocket fallback).
MQTT_URL=mqtt://localhost:1883
# Dev credentials of the API processes (docker/emqx/users.json + acl.conf). Production uses mTLS: leave empty.
MQTT_USERNAME=getproperty-api
MQTT_PASSWORD=getproperty-api
# PEM paths for TLS / mTLS towards the broker (CA to trust; client certificate + key of the API). Empty in dev.
MQTT_TLS_CA=
MQTT_TLS_CERT=
MQTT_TLS_KEY=
# EMQX shared-subscription group of the ingest replicas: $share/<group>/gp/v1/+/telemetry|health|events|cmd/ack.
MQTT_SHARED_GROUP=ingest
# Shared subscription on/off (off for brokers without $share, e.g. the in-process test broker) and MQTT version.
MQTT_SHARED_SUBSCRIPTION=true
MQTT_PROTOCOL_VERSION=5
# Client id prefix (the process id is appended so replicas never collide).
MQTT_CLIENT_ID_PREFIX=getproperty-api

# --- AWS (LocalStack in development; the Collective platform on AWS ap-southeast-7 in uat / prod — D-230) -----
# Same names as getpack. On the platform box: AWS_REGION and S3_BUCKET come from the product compose file
# (collective-<env>-getproperty-assets), credentials from the EC2 instance role (no keys, no endpoint).
AWS_REGION=ap-southeast-1
# Custom endpoint for LocalStack; leave empty for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack dummy credentials (real deployments use the task/instance role — never keys in env).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Private bucket for meter photos, inspection photos, slips, ID documents, contracts, logos.
S3_BUCKET=getproperty-dev
# Path-style URLs (required by LocalStack).
S3_FORCE_PATH_STYLE=true
# Optional prefix for every object key when the bucket is shared (e.g. getproperty/). With real AWS keep
# AWS_ENDPOINT_URL empty and S3_FORCE_PATH_STYLE=false — never put a path in the endpoint.
S3_KEY_PREFIX=
# Optional Secrets Manager secret (JSON object of VAR=value) loaded before validation.
# Explicit environment variables win over secret values. Ignored when INTEGRATIONS_MODE=fake.
# Empty on the Collective platform: the box renders collective/<env>/getproperty/app into the env file itself.
AWS_SECRETS_ID=

# --- HTTP ------------------------------------------------------------------------------------------
# API docs: /docs (Scalar), /docs/swagger, /docs-json, /docs.yaml (contract §5).
# development/test: always on. production: only when DOCS_ENABLED=true AND the caller IP is in
# DOCS_ALLOWED_CIDRS (comma-separated IPs/CIDRs; empty = nobody). Platform-token access arrives in B1.3.
DOCS_ENABLED=false
DOCS_ALLOWED_CIDRS=
# Reverse-proxy hops in front of the API (Express `trust proxy`) so client IPs are real — used by
# rate limiting and the docs allow-list. Counted from the RIGHT of X-Forwarded-For (the left-most entry is the
# caller's own claim). 0 locally; 1 on the Collective platform (Caddy is the one proxy; RUNBOOK §11, D-229, D-230).
TRUST_PROXY=0
# Where our BFFs (getproperty-web, getproperty-liff containers) call the API from: the platform's docker network
# `collective` (172.30.0.0/16). One more hop from there is trusted, so the end user's address the BFF forwards is the
# client IP. Empty = none.
TRUSTED_PROXY_CIDRS=
# Who may read GET /metrics (by client IP). Empty = loopback + private ranges (Grafana Alloy on the docker network).
METRICS_ALLOWED_CIDRS=
# /health + /metrics ports of the worker and ingest processes (the platform's image contract, D-230).
WORKER_HEALTH_PORT=3001
INGEST_HEALTH_PORT=3002
# Global rate limit per client: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- Authentication (contract §4, B1.3) ---------------------------------------------------------------
# Access tokens are EdDSA JWTs; the private key is an Ed25519 PKCS#8 PEM (\n-escaped or base64). Empty outside
# production = a per-process key (tokens die with the process). JWKS: GET /v1/auth/.well-known/jwks.json.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KID=gp-dev-1
# Previous verification keys during a rotation: JSON {"kid": "<public or private PEM>"}.
AUTH_JWT_PREVIOUS_KEYS=
# Token lifetimes (security parameters, not business values).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PLATFORM_REFRESH_TOKEN_TTL_HOURS=12
DEVICE_ACCESS_TOKEN_TTL_SECONDS=3600
DEVICE_REFRESH_TOKEN_TTL_DAYS=365
# Rotation grace (D-229): the previous refresh token presented again within N s of its rotation gets the same
# successor instead of revoking the family (parallel BFF instances). 0 = off, max 60.
REFRESH_REUSE_GRACE_SECONDS=30
# SMS OTP: lifetime, wrong attempts per challenge, resend interval and hourly cap per phone and purpose.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
# Password sign-in lockout after LOGIN_MAX_FAILURES failures, for LOGIN_LOCK_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Per-client limit of the /v1/auth endpoints (requests per THROTTLE_TTL_SECONDS); tests raise it.
AUTH_THROTTLE_LIMIT=10

# --- Providers (INTEGRATIONS_MODE=real; fakes otherwise) -----------------------------------------------
# LINE Login channel ids accepted as the `aud` of LIFF id tokens (comma-separated), LINE Messaging API token.
LINE_LOGIN_CHANNEL_IDS=
LINE_MESSAGING_ACCESS_TOKEN=
# SMS gateway (ThaiBulkSMS-compatible HTTP API).
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=getproperty
# PDF rendering with puppeteer-core (contracts, statements): Chromium/Chrome binary, render timeout.
PDF_CHROMIUM_EXECUTABLE=
PDF_RENDER_TIMEOUT_MS=30000
# Email (Amazon SES v2) sender — a verified identity (same name as getpack; D-230).
SES_FROM_ADDRESS=getproperty <no-reply@getproperty.co>
# Web push (VAPID) keys: `npx web-push generate-vapid-keys`.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:dev@getproperty.co
# ClamAV daemon (INSTREAM) for the file virus scan.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Links in invitations and messages.
# Owner console (and Owner/Manager/Accountant invitations), staff PWA (Staff invitations), resident LIFF app.
PUBLIC_WEB_APP_URL=http://localhost:3001
PUBLIC_STAFF_APP_URL=http://staff.localhost:3001
PUBLIC_RESIDENT_APP_URL=http://localhost:3300

# --- Devices (D-130) -------------------------------------------------------------------------------------
# Platform device CA (EC P-256): certificate + PKCS#8 key PEM. Empty outside production = an ephemeral CA per process.
DEVICE_CA_CERT=
DEVICE_CA_KEY=
DEVICE_CERT_VALIDITY_DAYS=365
# Broker URL handed to gateways at bootstrap (MQTT over TLS, mutual TLS).
MQTT_PUBLIC_URL=mqtts://mqtt.getproperty.invalid:8883
# WSS fallback URL for networks that block 8883: leave unset — the bootstrap then omits mqtt.wsUrl (D-231, O-012).
# MQTT_PUBLIC_WS_URL=wss://mqtt.getproperty.invalid/mqtt
# Device host origin for URLs handed to gateways (ota_apply.manifestUrl); empty → relative /v1/device/… paths (D-231).
DEVICE_PUBLIC_BASE_URL=
# OTA manifest signing keys trusted for new releases: {"<keyId>":"<base64 raw ed25519 public key>"}.
OTA_SIGNING_PUBLIC_KEYS=
# Gateway mTLS on /v1/device/*: socket (TLS terminated here) | pem_header | sha256_header (trusted proxy header).
# On the Collective platform Caddy verifies the gateway certificate on the device host and forwards its SHA-256:
# DEVICE_MTLS_SOURCE=sha256_header, DEVICE_MTLS_HEADER=x-client-cert-sha256 (docs/deployment.md §5).
DEVICE_MTLS_SOURCE=socket
DEVICE_MTLS_HEADER=x-client-cert

# --- AI gateway (D-161) — vision OCR of meter photos and utility invoices; empty URL = OCR unavailable -----------
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_VISION_MODEL=vision-default
AI_GATEWAY_TIMEOUT_MS=30000

# --- Observability ---------------------------------------------------------------------------------
# Sentry DSN; empty disables Sentry. PII is never sent (headers, cookies, bodies are stripped).
SENTRY_DSN=
# Share of requests traced by Sentry (0–1).
SENTRY_TRACES_SAMPLE_RATE=0
# OTLP/HTTP collector base URL (e.g. http://localhost:4318); empty disables OpenTelemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name on traces, logs and metrics (the worker appends "-worker", the ingest process "-ingest", unless the
# name already ends so — the platform compose file names each container's service).
OTEL_SERVICE_NAME=getproperty-api
# Git commit of the build (set by the image build); shown by GET /v1/admin/system/info.
GIT_COMMIT=

# --- Secrets (ADR-0003; from Secrets Manager in real environments, never committed) -------------------
# AES-256-GCM key, 32 bytes base64, for secrets stored in the database (national ids, TOTP secrets — D-025).
# Required in production; development and tests derive a per-process key.
FIELD_ENCRYPTION_KEY=
# HMAC key of lookup hashes (phone_hash, id_number_hash, OTP codes; schema-design §4.7). Required in production;
# development and tests use a fixed development key so local lookups survive restarts.
FIELD_HASH_KEY=

# --- Tests (not read by the app) ------------------------------------------------------------------
# `EMBEDDED_PG=1 pnpm test:int` starts an embedded PostgreSQL 18 for the integration suite (no Docker; as OS
# user `postgres` when run as root, EMBEDDED_PG_OS_USER). Or point the suite at a server with a superuser URL:
# INT_DATABASE_URL=postgresql://gp:gp@localhost:5432/postgres
# CI sets PRISMA_MIGRATE_DIFF=1 to also run the real `prisma migrate diff` inside the suite.

# --- e-Tax service providers (B6.2, D-215) --------------------------------------------------------------------
# ETAX_INET_BASE_URL=https://service-etax.one.th/etaxdocumentws
# ETAX_SECRETS_PREFIX=getproperty/etax

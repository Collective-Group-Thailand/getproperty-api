{
  "name": "getproperty-api",
  "version": "0.1.0",
  "description": "getproperty — บิลทำเอง เก็บเงินเอง ถูกกฎหมาย · backend (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "build:fast": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && swc src scripts prisma/seed -d dist --config-file .swcrc --copy-files --ignore \"**/*.spec.ts\" --quiet && node -e \"require('node:fs').copyFileSync('package.json','dist/package.json')\"",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "start:ingest": "node dist/src/ingest.js",
    "dev": "nest start --watch -b swc --path tsconfig.build.json",
    "dev:worker": "nest start --watch -b swc --path tsconfig.build.json --entryFile src/worker",
    "dev:ingest": "nest start --watch -b swc --path tsconfig.build.json --entryFile src/ingest",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects unit",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects unit --coverage",
    "test:int": "node scripts/run-int-tests.mjs",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --selectProjects e2e --maxWorkers=1",
    "contract:build": "nest build && node dist/scripts/contract-build.js",
    "contract:lint": "spectral lint contract/openapi.json --ruleset contract/spectral/.spectral.yaml --fail-severity warn",
    "release:check": "pnpm build:fast && node dist/scripts/release-hygiene.js",
    "postinstall": "node scripts/prisma-generate.mjs",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "prisma:core": "asset-core prisma-fragment --relations-from prisma/schema --out prisma/schema/core.prisma && node scripts/prisma-generate.mjs",
    "db:local": "node scripts/local-pg.mjs",
    "db:migrate": "asset-core migrate && prisma migrate deploy",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "db:seed": "pnpm build:fast && node dist/prisma/seed/run.js reference",
    "db:seed:dev": "pnpm build:fast && node dist/prisma/seed/run.js dev",
    "rbac:build": "pnpm build:fast && node dist/scripts/rbac-build.js",
    "compliance:report": "pnpm build:fast && node dist/scripts/compliance-report.js",
    "sim:gateway": "node scripts/sim-gateway.mjs",
    "db:migrate:deploy": "node dist/src/migrate.js",
    "credentials:import": "node dist/src/credentials-import.js",
    "drill:smoke": "node dist/src/drill-smoke.js",
    "device:broker-cert": "node scripts/broker-cert.mjs",
    "brand:png": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sesv2": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@collective/asset-core": "link:../collective-asset-core",
    "@fontsource/sarabun": "5.2.8",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@peculiar/x509": "2.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@scalar/api-reference": "^1.74.0",
    "@scalar/nestjs-api-reference": "^1.2.29",
    "@sentry/nestjs": "^11.8.0",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mjml": "5.4.0",
    "mqtt": "^5.16.1",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer-core": "24.25.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.3",
    "@prisma/prisma-schema-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@stoplight/spectral-cli": "^6.17.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.0.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "aedes": "1.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.5.2",
    "pgsql-parser": "^18.2.12",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@swc/core",
      "protobufjs",
      "msgpackr-extract",
      "@parcel/watcher",
      "cpu-features",
      "ssh2",
      "unrs-resolver",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/windows-x64"
    ]
  }
}
